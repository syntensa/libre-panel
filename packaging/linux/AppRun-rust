#!/bin/sh
# Entry point of the AppImage of Libre Panel in Rust (docs/RUST.md). Without a command (a
# double-click) Libre Panel starts in the background with its tray icon; with one it is the
# normal command line: ./Libre_Panel-x86_64.AppImage editor | autostart enable | ...
# The libraries of C that draw as Pillow draws (FreeType, HarfBuzz, libjpeg, libwebp: Pillow's
# own, in lib) are named to the program; nothing goes into LD_LIBRARY_PATH, so that the window
# and the tray icon use the system's GTK with the system's libraries.
HERE="$(dirname "$(readlink -f "$0")")"
APP="$HERE/usr/lib/libre-panel"
pick() {
    for file in "$APP/lib/$2"*; do
        if [ -e "$file" ]; then
            export "$1=$file"
            return
        fi
    done
}
pick LP_LIBFREETYPE libfreetype
pick LP_LIBHARFBUZZ libharfbuzz
pick LP_LIBJPEG libjpeg
pick LP_LIBWEBPDEMUX libwebpdemux
pick LP_LIBWEBPMUX libwebpmux
pick LP_LIBWEBP libwebp-
if [ "$#" -eq 0 ]; then
    set -- tray
fi
exec "$APP/libre-panel" "$@"
