{
  "format": "libre-panel-theme/1",
  "name": "Studio",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Studio for round 2.1\" and 2.8\" panels: the time large with its seconds, and the load of the CPU, the GPU and the RAM as rings under it, with the network.",
  "display": {
    "model": "turing-2.8-usb",
    "orientation": "landscape",
    "width": 480,
    "height": 480
  },
  "palette": {
    "void": "#000000",
    "base_low": "#060A0F",
    "base": "#0A1119",
    "surf_1": "#14202E",
    "surf_2": "#1F3147",
    "track": "#162332",
    "rule_soft": "#1C2B3C",
    "rule": "#32475E",
    "tx_1": "#EEF6FF",
    "tx_2": "#B8CAE0",
    "tx_3": "#8CA0B8",
    "accent": "#13E5D7",
    "accent_deep": "#19746E",
    "cpu": "#13E5D7",
    "cpu_deep": "#19746E",
    "mem": "#E0A8FF",
    "mem_deep": "#6E4C8F",
    "gpu": "#A3AEFF",
    "gpu_deep": "#4A55A8",
    "net": "#7EE8A6",
    "net_deep": "#2F7A52",
    "disk": "#7EE8A6",
    "disk_deep": "#2F7A52",
    "ok": "#6FE3B5",
    "warn": "#FFCB6B",
    "krit": "#FF7A85",
    "bg": "#0A1119",
    "surface": "#14202E",
    "line": "#32475E",
    "text": "#EEF6FF",
    "text2": "#B8CAE0",
    "text3": "#8CA0B8",
    "crit": "#FF7A85"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@base",
    "image": null
  },
  "refresh_ms": 500,
  "animation": {
    "smoothing_ms": 600
  },
  "widgets": [
    {
      "type": "rect",
      "id": "ground",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "color": "@base_low",
      "color2": "@base",
      "locked": true
    },
    {
      "type": "rect",
      "id": "groove",
      "x": 4,
      "y": 4,
      "w": 472,
      "h": 472,
      "radius": 236,
      "color": "#00000000",
      "outline": "@line",
      "outline_width": 2,
      "locked": true
    },
    {
      "type": "gauge",
      "id": "seconds-rim",
      "x": 13,
      "y": 13,
      "w": 454,
      "h": 454,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "start_angle": 270,
      "end_angle": 630,
      "thickness": 3,
      "color": "@accent",
      "background": "#00000000",
      "glow": 0.7,
      "glow_radius": 6,
      "smooth": false
    },
    {
      "type": "clock",
      "id": "date",
      "x": 240,
      "y": 60,
      "format": "%A · %d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 15,
      "color": "@text3",
      "align": "center",
      "uppercase": true,
      "letter_spacing": 2.2,
      "tabular": false
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 240,
      "y": 78,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 92,
      "color": "@text",
      "align": "center",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 362,
      "y": 96,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 28,
      "color": "@accent",
      "align": "left",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 8
    },
    {
      "type": "icon",
      "id": "uptime-icon",
      "x": 364,
      "y": 157,
      "icon": "uptime",
      "size": 15,
      "color": "@text3",
      "stroke": 1.5,
      "needs": "sys.uptime"
    },
    {
      "type": "metric",
      "id": "uptime",
      "x": 383,
      "y": 155,
      "sensor": "sys.uptime",
      "format": "{value:duration}",
      "font": "builtin:Barlow-Medium",
      "font_size": 15,
      "color": "@text3",
      "max_width": 79,
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "gauge",
      "id": "cpu-ring",
      "x": 54,
      "y": 208,
      "w": 108,
      "h": 108,
      "sensor": "cpu.load",
      "start_angle": 135,
      "end_angle": 405,
      "thickness": 12,
      "color": "@cpu",
      "background": "@track",
      "glow": 0.6,
      "glow_radius": 8,
      "smooth": true,
      "color_rules": [
        {
          "above": 92,
          "color": "@crit"
        }
      ],
      "cap": "flat"
    },
    {
      "type": "metric",
      "id": "cpu-value",
      "x": 108,
      "y": 244,
      "sensor": "cpu.load",
      "format": "{value:.0f}%",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 28,
      "color": "@text",
      "align": "center",
      "smooth": true
    },
    {
      "type": "text",
      "id": "cpu-label",
      "x": 108,
      "y": 322,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@cpu",
      "align": "center",
      "tabular": false,
      "letter_spacing": 2.2
    },
    {
      "type": "metric",
      "id": "cpu-sub",
      "x": 108,
      "y": 342,
      "sensor": "cpu.temp",
      "format": "{value:.0f}°C",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text2",
      "align": "center",
      "smooth": true
    },
    {
      "type": "gauge",
      "id": "gpu-ring",
      "x": 186,
      "y": 208,
      "w": 108,
      "h": 108,
      "sensor": "gpu.load",
      "start_angle": 135,
      "end_angle": 405,
      "thickness": 12,
      "color": "@gpu",
      "background": "@track",
      "glow": 0.6,
      "glow_radius": 8,
      "smooth": true,
      "color_rules": [
        {
          "above": 92,
          "color": "@crit"
        }
      ],
      "needs": "gpu.load",
      "cap": "flat"
    },
    {
      "type": "metric",
      "id": "gpu-value",
      "x": 240,
      "y": 244,
      "sensor": "gpu.load",
      "format": "{value:.0f}%",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 28,
      "color": "@text",
      "align": "center",
      "smooth": true,
      "needs": "gpu.load"
    },
    {
      "type": "text",
      "id": "gpu-label",
      "x": 240,
      "y": 322,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@gpu",
      "align": "center",
      "tabular": false,
      "letter_spacing": 2.2,
      "needs": "gpu.load"
    },
    {
      "type": "metric",
      "id": "gpu-sub",
      "x": 240,
      "y": 342,
      "sensor": "gpu.temp",
      "format": "{value:.0f}°C",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text2",
      "align": "center",
      "needs": "gpu.load",
      "smooth": true
    },
    {
      "type": "gauge",
      "id": "mem-ring",
      "x": 318,
      "y": 208,
      "w": 108,
      "h": 108,
      "sensor": "mem.load",
      "start_angle": 135,
      "end_angle": 405,
      "thickness": 12,
      "color": "@mem",
      "background": "@track",
      "glow": 0.6,
      "glow_radius": 8,
      "smooth": true,
      "color_rules": [
        {
          "above": 92,
          "color": "@crit"
        }
      ],
      "cap": "flat"
    },
    {
      "type": "metric",
      "id": "mem-value",
      "x": 372,
      "y": 244,
      "sensor": "mem.load",
      "format": "{value:.0f}%",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 28,
      "color": "@text",
      "align": "center",
      "smooth": true
    },
    {
      "type": "text",
      "id": "mem-label",
      "x": 372,
      "y": 322,
      "text": "RAM",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@mem",
      "align": "center",
      "tabular": false,
      "letter_spacing": 2.2
    },
    {
      "type": "metric",
      "id": "mem-sub",
      "x": 372,
      "y": 342,
      "sensor": "mem.used",
      "format": "{value:.1f} GB",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text2",
      "align": "center",
      "smooth": true
    },
    {
      "type": "icon",
      "id": "down-icon",
      "x": 171,
      "y": 378,
      "icon": "download",
      "size": 18,
      "color": "@net"
    },
    {
      "type": "metric",
      "id": "down",
      "x": 180,
      "y": 398,
      "sensor": "net.down",
      "format": "{value:bytes}/s",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text2",
      "align": "center",
      "smooth": true
    },
    {
      "type": "icon",
      "id": "up-icon",
      "x": 291,
      "y": 378,
      "icon": "upload",
      "size": 18,
      "color": "@gpu"
    },
    {
      "type": "metric",
      "id": "up",
      "x": 300,
      "y": 398,
      "sensor": "net.up",
      "format": "{value:bytes}/s",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text2",
      "align": "center",
      "smooth": true
    }
  ],
  "style": {
    "card": "glass",
    "radius": 12,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium",
    "card_opacity": 0.85
  }
}
