{
  "format": "libre-panel-theme/1",
  "name": "Nimbus 5.2″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Libre Panel's weather screen for 8.8\" and 9.2\" bars: the weather now with its moving symbol and the next hours, the next days side by side, the moon as it is lit tonight with the days until the next full and new moon, and a small clock. Without a place for the weather a calendar sheet and the month stand in.",
  "display": {
    "model": "turing-5.2-usb",
    "orientation": "landscape",
    "width": 1280,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png",
    "gradient": [
      "@bg",
      "@bg2"
    ]
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 72,
    "gap": 1,
    "margin": 16
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium",
    "card_opacity": 0.7
  },
  "widgets": [
    {
      "type": "module",
      "id": "weather",
      "module": "forecast",
      "col": 0,
      "row": 0,
      "cols": 30,
      "rows": 40
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 782,
      "y": 5,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 84,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1013,
      "y": 21,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 30,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 8
    },
    {
      "type": "clock",
      "id": "weekday",
      "x": 1244,
      "y": 25,
      "format": "%A",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text2",
      "uppercase": true,
      "letter_spacing": 3,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "clock",
      "id": "date",
      "x": 1244,
      "y": 61,
      "format": "%d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "uppercase": true,
      "letter_spacing": 3,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "module",
      "id": "moon",
      "module": "moon",
      "col": 30,
      "row": 12,
      "cols": 18,
      "rows": 28
    },
    {
      "type": "module",
      "id": "days",
      "module": "outlook",
      "col": 0,
      "row": 40,
      "cols": 48,
      "rows": 32
    }
  ]
}
