{
  "format": "libre-panel-theme/1",
  "name": "Nimbus",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Nimbus for round panels of 480x480: the sky as a moving symbol, the temperature large, the day's high and low, the next three days along the bottom.",
  "display": {
    "model": "turing-2.8-usb",
    "orientation": "landscape",
    "width": 480,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": null
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "ground",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "color": "@bg2",
      "color2": "@bg",
      "locked": true
    },
    {
      "type": "rect",
      "id": "groove",
      "x": 4,
      "y": 4,
      "w": 472,
      "h": 472,
      "radius": 236,
      "color": "#00000000",
      "outline": "@line",
      "outline_width": 2,
      "locked": true
    },
    {
      "type": "symbol",
      "id": "sky",
      "x": 170,
      "y": 34,
      "size": 140,
      "needs": "weather.temperature"
    },
    {
      "type": "weather",
      "id": "temperature",
      "x": 240,
      "y": 170,
      "field": "temperature",
      "format": "{value:.0f}°",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 86,
      "color": "@text",
      "align": "center",
      "finish": "acrylic",
      "needs": "weather.temperature"
    },
    {
      "type": "weather",
      "id": "sky-words",
      "x": 240,
      "y": 272,
      "field": "description",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 20,
      "color": "@text2",
      "align": "center",
      "max_width": 320,
      "fit": "shrink",
      "needs": "weather.temperature"
    },
    {
      "type": "metric",
      "id": "high",
      "x": 232,
      "y": 304,
      "sensor": "weather.day.0.high",
      "format": "{value:.0f}°",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "color": "@warn",
      "align": "right",
      "needs": "weather.temperature",
      "smooth": true
    },
    {
      "type": "text",
      "id": "high-low",
      "x": 240,
      "y": 304,
      "text": "/",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "color": "@dim",
      "align": "center",
      "tabular": false,
      "needs": "weather.temperature"
    },
    {
      "type": "metric",
      "id": "low",
      "x": 248,
      "y": 304,
      "sensor": "weather.day.0.low",
      "format": "{value:.0f}°",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "color": "@disk",
      "align": "left",
      "needs": "weather.temperature",
      "smooth": true
    },
    {
      "type": "metric",
      "id": "day1-name",
      "x": 158,
      "y": 352,
      "sensor": "weather.day.1.name",
      "format": "{value:upper}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@text3",
      "align": "center",
      "letter_spacing": 1.6,
      "needs": "weather.temperature"
    },
    {
      "type": "icon",
      "id": "day1-icon",
      "x": 144,
      "y": 372,
      "icon": "weather",
      "sensor": "weather.day.1.code",
      "size": 28,
      "color": "@text2",
      "needs": "weather.temperature"
    },
    {
      "type": "metric",
      "id": "day1-high",
      "x": 158,
      "y": 406,
      "sensor": "weather.day.1.high",
      "format": "{value:.0f}°",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 18,
      "color": "@text",
      "align": "center",
      "needs": "weather.temperature",
      "smooth": true
    },
    {
      "type": "metric",
      "id": "day2-name",
      "x": 240,
      "y": 352,
      "sensor": "weather.day.2.name",
      "format": "{value:upper}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@text3",
      "align": "center",
      "letter_spacing": 1.6,
      "needs": "weather.temperature"
    },
    {
      "type": "icon",
      "id": "day2-icon",
      "x": 226,
      "y": 372,
      "icon": "weather",
      "sensor": "weather.day.2.code",
      "size": 28,
      "color": "@text2",
      "needs": "weather.temperature"
    },
    {
      "type": "metric",
      "id": "day2-high",
      "x": 240,
      "y": 406,
      "sensor": "weather.day.2.high",
      "format": "{value:.0f}°",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 18,
      "color": "@text",
      "align": "center",
      "needs": "weather.temperature",
      "smooth": true
    },
    {
      "type": "metric",
      "id": "day3-name",
      "x": 322,
      "y": 352,
      "sensor": "weather.day.3.name",
      "format": "{value:upper}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@text3",
      "align": "center",
      "letter_spacing": 1.6,
      "needs": "weather.temperature"
    },
    {
      "type": "icon",
      "id": "day3-icon",
      "x": 308,
      "y": 372,
      "icon": "weather",
      "sensor": "weather.day.3.code",
      "size": 28,
      "color": "@text2",
      "needs": "weather.temperature"
    },
    {
      "type": "metric",
      "id": "day3-high",
      "x": 322,
      "y": 406,
      "sensor": "weather.day.3.high",
      "format": "{value:.0f}°",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 18,
      "color": "@text",
      "align": "center",
      "needs": "weather.temperature",
      "smooth": true
    },
    {
      "type": "clock",
      "id": "clock-off",
      "x": 240,
      "y": 150,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 96,
      "color": "@text",
      "align": "center",
      "needs": "!weather.temperature",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "date-off",
      "x": 240,
      "y": 270,
      "format": "%A · %d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 18,
      "color": "@text3",
      "align": "center",
      "uppercase": true,
      "letter_spacing": 2,
      "tabular": false,
      "needs": "!weather.temperature"
    }
  ]
}
