{
  "format": "libre-panel-theme/1",
  "name": "Studio 0.96″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Studio for tiny panels (160x80, WeAct 0.96\"): the time large, and the load of the CPU, the RAM and the GPU under it.",
  "display": {
    "model": "weact-0.96",
    "orientation": "landscape",
    "width": 160,
    "height": 80
  },
  "palette": {
    "void": "#000000",
    "base_low": "#060A0F",
    "base": "#0A1119",
    "surf_1": "#14202E",
    "surf_2": "#1F3147",
    "track": "#162332",
    "rule_soft": "#1C2B3C",
    "rule": "#32475E",
    "tx_1": "#EEF6FF",
    "tx_2": "#B8CAE0",
    "tx_3": "#8CA0B8",
    "accent": "#13E5D7",
    "accent_deep": "#19746E",
    "cpu": "#13E5D7",
    "cpu_deep": "#19746E",
    "mem": "#E0A8FF",
    "mem_deep": "#6E4C8F",
    "gpu": "#A3AEFF",
    "gpu_deep": "#4A55A8",
    "net": "#7EE8A6",
    "net_deep": "#2F7A52",
    "disk": "#7EE8A6",
    "disk_deep": "#2F7A52",
    "ok": "#6FE3B5",
    "warn": "#FFCB6B",
    "krit": "#FF7A85",
    "bg": "#0A1119",
    "surface": "#14202E",
    "line": "#32475E",
    "text": "#EEF6FF",
    "text2": "#B8CAE0",
    "text3": "#8CA0B8",
    "crit": "#FF7A85"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "gradient": [
      "#0A1119",
      "#0A1119"
    ]
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "widgets": [
    {
      "type": "clock",
      "id": "clock",
      "x": 80,
      "y": 2,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 36,
      "color": "@text",
      "digits": "roll",
      "align": "center"
    },
    {
      "type": "metric",
      "id": "cpu",
      "x": 30,
      "y": 54,
      "sensor": "cpu.load",
      "format": "{value:.0f}%",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@cpu",
      "align": "center",
      "smooth": true,
      "tabular": true
    },
    {
      "type": "metric",
      "id": "mem",
      "x": 80,
      "y": 54,
      "sensor": "mem.load",
      "format": "{value:.0f}%",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@mem",
      "align": "center",
      "smooth": true,
      "tabular": true
    },
    {
      "type": "metric",
      "id": "gpu",
      "x": 130,
      "y": 54,
      "sensor": "gpu.load",
      "format": "{value:.0f}%",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@gpu",
      "align": "center",
      "smooth": true,
      "tabular": true
    },
    {
      "type": "text",
      "id": "cpu-label",
      "x": 30,
      "y": 44,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 9,
      "color": "@text3",
      "align": "center",
      "letter_spacing": 2,
      "tabular": false
    },
    {
      "type": "text",
      "id": "mem-label",
      "x": 80,
      "y": 44,
      "text": "RAM",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 9,
      "color": "@text3",
      "align": "center",
      "letter_spacing": 2,
      "tabular": false
    },
    {
      "type": "text",
      "id": "gpu-label",
      "x": 130,
      "y": 44,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 9,
      "color": "@text3",
      "align": "center",
      "letter_spacing": 2,
      "tabular": false
    }
  ]
}
