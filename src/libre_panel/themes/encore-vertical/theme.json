{
  "format": "libre-panel-theme/1",
  "name": "Encore Vertical",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Encore for 8.8\" and 9.2\" bars on end: what plays with its cover large and its colours behind the whole screen, the time with rolling digits and its seconds, and the volume as levels on a mixer.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "portrait",
    "width": 480,
    "height": 1920
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 12,
    "rows": 48,
    "gap": 1,
    "margin": 16
  },
  "toast": {
    "off": [
      "volume"
    ]
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "image",
      "id": "ambient",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 1920,
      "src": "@media.cover",
      "fit": "cover",
      "blur": 56,
      "opacity": 0.9,
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "veil",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 1920,
      "color": "#0A0E1338",
      "color2": "#0A0E13F2",
      "gradient": "vertical",
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "cover-frame",
      "x": 18,
      "y": 0,
      "w": 462,
      "h": 462,
      "color": "#121A24",
      "needs": "!@media.cover"
    },
    {
      "type": "icon",
      "id": "cover-icon",
      "x": 175,
      "y": 157,
      "icon": "music",
      "size": 148,
      "color": "@dim",
      "stroke": 1.6,
      "needs": "!@media.cover"
    },
    {
      "type": "image",
      "id": "cover",
      "x": 18,
      "y": 0,
      "w": 462,
      "h": 462,
      "src": "@media.cover",
      "fit": "cover",
      "shadow": "#00000099",
      "shadow_offset": 6,
      "shadow_blur": 22
    },
    {
      "type": "icon",
      "id": "playing-sign",
      "x": 42,
      "y": 522,
      "icon": "play",
      "size": 24,
      "color": "@cover",
      "needs": "media.playing=1, media.title"
    },
    {
      "type": "icon",
      "id": "paused-sign",
      "x": 42,
      "y": 522,
      "icon": "pause",
      "size": 24,
      "color": "@cover",
      "needs": "media.playing=0, media.title"
    },
    {
      "type": "metric",
      "id": "state",
      "x": 78,
      "y": 519,
      "sensor": "media.state",
      "format": "{value:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@cover",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "max_width": 378,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "title",
      "x": 42,
      "y": 570,
      "sensor": "media.title",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 60,
      "color": "@text",
      "tabular": false,
      "fallback": "",
      "max_width": 414,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "artist",
      "x": 42,
      "y": 661,
      "sensor": "media.artist",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 38,
      "color": "@text2",
      "tabular": false,
      "fallback": "",
      "max_width": 414,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "album",
      "x": 42,
      "y": 722,
      "sensor": "media.album",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 28,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 414,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "image",
      "id": "app-icon",
      "x": 42,
      "y": 772,
      "w": 32,
      "h": 32,
      "src": "@media.app_icon",
      "fit": "contain",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "app",
      "x": 86,
      "y": 773,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 370,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "@media.app_icon, media.title"
    },
    {
      "type": "metric",
      "id": "app-bare",
      "x": 42,
      "y": 773,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 414,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "!@media.app_icon, media.title"
    },
    {
      "type": "bar",
      "id": "progress",
      "x": 42,
      "y": 866,
      "w": 414,
      "h": 8,
      "sensor": "media.progress",
      "min": 0,
      "max": 1,
      "color": "@cover",
      "background": "@track",
      "radius": 4,
      "smooth": true,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 10,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "position",
      "x": 42,
      "y": 889,
      "sensor": "media.position",
      "format": "{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text3",
      "max_width": 207,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "left",
      "x": 456,
      "y": 889,
      "sensor": "media.remaining",
      "format": "-{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text3",
      "align": "right",
      "max_width": 207,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "text",
      "id": "idle",
      "x": 42,
      "y": 653,
      "text": "Nothing playing",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 44,
      "color": "@text2",
      "tabular": false,
      "translate": true,
      "needs": "!media.title"
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 46,
      "y": 997,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 130,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 402,
      "y": 1023,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 44,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 10
    },
    {
      "type": "rect",
      "id": "seconds-groove",
      "x": 46,
      "y": 1203,
      "w": 406,
      "h": 2,
      "color": "@track"
    },
    {
      "type": "bar",
      "id": "seconds-run",
      "x": 46,
      "y": 1203,
      "w": 406,
      "h": 2,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "color": "@accent",
      "background": null,
      "radius": 0,
      "smooth": false,
      "end_dot": 4.5
    },
    {
      "type": "clock",
      "id": "date",
      "x": 249,
      "y": 1152,
      "format": "%A · %d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "uppercase": true,
      "letter_spacing": 3,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "module",
      "id": "volume",
      "module": "volume",
      "col": 0,
      "row": 38,
      "cols": 12,
      "rows": 10,
      "card": "off"
    }
  ]
}
