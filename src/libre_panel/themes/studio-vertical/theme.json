{
  "format": "libre-panel-theme/1",
  "name": "Studio Vertical",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Studio for 8.8\" and 9.2\" bars on end: a large clock, a card with what plays (the weather when nothing does, a calendar sheet while there is neither), and a row for each of CPU, memory and GPU (the disk without GPU readings): a lit ring, its readings and the name of your hardware.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "portrait",
    "width": 480,
    "height": 1920
  },
  "palette": {
    "void": "#000000",
    "base_low": "#060A0F",
    "base": "#0A1119",
    "surf_1": "#14202E",
    "surf_2": "#1F3147",
    "track": "#162332",
    "rule_soft": "#1C2B3C",
    "rule": "#32475E",
    "tx_1": "#EEF6FF",
    "tx_2": "#B8CAE0",
    "tx_3": "#8CA0B8",
    "accent": "#13E5D7",
    "accent_deep": "#19746E",
    "cpu": "#13E5D7",
    "cpu_deep": "#19746E",
    "mem": "#E0A8FF",
    "mem_deep": "#6E4C8F",
    "gpu": "#A3AEFF",
    "gpu_deep": "#4A55A8",
    "net": "#7EE8A6",
    "net_deep": "#2F7A52",
    "disk": "#7EE8A6",
    "disk_deep": "#2F7A52",
    "ok": "#6FE3B5",
    "warn": "#FFCB6B",
    "krit": "#FF7A85",
    "bg": "#0A1119",
    "surface": "#14202E",
    "line": "#32475E",
    "text": "#EEF6FF",
    "text2": "#B8CAE0",
    "text3": "#8CA0B8",
    "crit": "#FF7A85"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@base",
    "image": null
  },
  "refresh_ms": 500,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 12,
    "rows": 48,
    "gap": 1,
    "margin": 22
  },
  "style": {
    "card": "glass",
    "radius": 12,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "backdrop",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 1920,
      "color": "@base",
      "color2": "@base_low",
      "locked": true
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 42,
      "y": 32,
      "format": "%H:%M",
      "digits": "roll",
      "font_size": 128,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "glow": 0.18,
      "glow_radius": 14
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 388,
      "y": 57,
      "format": "%S",
      "digits": "roll",
      "font_size": 44,
      "color": "@accent",
      "font": "builtin:Barlow-SemiBold",
      "glow": 0.7,
      "glow_radius": 10
    },
    {
      "type": "rect",
      "id": "signature",
      "x": 50,
      "y": 190,
      "w": 100,
      "h": 4,
      "color": "@accent",
      "radius": 2,
      "glow": 0.7,
      "glow_radius": 8
    },
    {
      "type": "clock",
      "id": "date",
      "x": 48,
      "y": 212,
      "format": "%A · %d %B",
      "font_size": 30,
      "color": "@tx_2",
      "tabular": false,
      "letter_spacing": 1,
      "needs": "weather.temperature"
    },
    {
      "type": "clock",
      "id": "date-music",
      "x": 48,
      "y": 212,
      "format": "%A · %d %B",
      "font_size": 30,
      "color": "@tx_2",
      "tabular": false,
      "letter_spacing": 1,
      "needs": "!weather.temperature, media.title"
    },
    {
      "type": "icon",
      "id": "net.down-icon",
      "x": 50,
      "y": 290,
      "icon": "download",
      "size": 26,
      "color": "@net",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "net.down-value",
      "x": 88,
      "y": 286,
      "sensor": "net.down",
      "format": "{value:bytes}/s",
      "font_size": 28,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true
    },
    {
      "type": "icon",
      "id": "net.up-icon",
      "x": 260,
      "y": 290,
      "icon": "upload",
      "size": 26,
      "color": "@net",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "net.up-value",
      "x": 298,
      "y": 286,
      "sensor": "net.up",
      "format": "{value:bytes}/s",
      "font_size": 28,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true
    },
    {
      "type": "icon",
      "id": "sys.uptime-icon",
      "x": 50,
      "y": 340,
      "icon": "clock",
      "size": 26,
      "color": "@tx_3",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "sys.uptime-value",
      "x": 88,
      "y": 336,
      "sensor": "sys.uptime",
      "format": "{value:duration}",
      "font_size": 28,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 0,
      "row": 10,
      "cols": 12,
      "rows": 18,
      "items": "playback\nforecast\ndate",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "rect",
      "id": "names-rule",
      "x": 42,
      "y": 1126,
      "w": 414,
      "h": 1,
      "color": "@rule_soft"
    },
    {
      "type": "gauge",
      "id": "cpu-ring",
      "x": 42,
      "y": 1150,
      "w": 190,
      "h": 190,
      "sensor": "cpu.load",
      "thickness": 16,
      "color": "@cpu",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "cpu.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "cpu-load",
      "x": 137,
      "y": 1202,
      "sensor": "cpu.load",
      "format": "{value:.0f}%",
      "font_size": 50,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "cpu.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "cpu-label",
      "x": 137,
      "y": 1268,
      "text": "CPU",
      "font_size": 17,
      "color": "@cpu",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "cpu.load"
    },
    {
      "type": "metric",
      "id": "cpu-temp",
      "x": 266,
      "y": 1184,
      "sensor": "cpu.temp",
      "format": "{value:.0f}°C",
      "font_size": 40,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [
        {
          "above": 75,
          "color": "@warn"
        },
        {
          "above": 88,
          "color": "@krit"
        }
      ],
      "needs": "cpu.load"
    },
    {
      "type": "metric",
      "id": "cpu-power",
      "x": 266,
      "y": 1242,
      "sensor": "cpu.power",
      "format": "{value:.0f} W",
      "font_size": 24,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "cpu.load",
      "smooth": true
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 266,
      "y": 1290,
      "sensor": "cpu.name",
      "format": "{value}",
      "font_size": 18,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "tabular": false,
      "align": "left",
      "max_width": 190,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": ""
    },
    {
      "type": "gauge",
      "id": "mem-ring",
      "x": 42,
      "y": 1395,
      "w": 190,
      "h": 190,
      "sensor": "mem.load",
      "thickness": 16,
      "color": "@mem",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "mem.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "mem-load",
      "x": 137,
      "y": 1447,
      "sensor": "mem.load",
      "format": "{value:.0f}%",
      "font_size": 50,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "mem.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "mem-label",
      "x": 137,
      "y": 1513,
      "text": "RAM",
      "font_size": 17,
      "color": "@mem",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "mem.load"
    },
    {
      "type": "metric",
      "id": "mem-used",
      "x": 266,
      "y": 1429,
      "sensor": "mem.used",
      "format": "{value:.1f} GB",
      "font_size": 40,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [],
      "needs": "mem.load"
    },
    {
      "type": "metric",
      "id": "mem-total",
      "x": 266,
      "y": 1487,
      "sensor": "mem.total",
      "format": "/ {value:.0f} GB",
      "smooth": true,
      "font_size": 24,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "mem.load"
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 266,
      "y": 1535,
      "sensor": "mem.name",
      "format": "{value}",
      "font_size": 18,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "tabular": false,
      "align": "left",
      "max_width": 190,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": ""
    },
    {
      "type": "gauge",
      "id": "gpu-ring",
      "x": 42,
      "y": 1640,
      "w": 190,
      "h": 190,
      "sensor": "gpu.load",
      "thickness": 16,
      "color": "@gpu",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "gpu.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "gpu-load",
      "x": 137,
      "y": 1692,
      "sensor": "gpu.load",
      "format": "{value:.0f}%",
      "font_size": 50,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "gpu.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "gpu-label",
      "x": 137,
      "y": 1758,
      "text": "GPU",
      "font_size": 17,
      "color": "@gpu",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "gpu.load"
    },
    {
      "type": "metric",
      "id": "gpu-temp",
      "x": 266,
      "y": 1674,
      "sensor": "gpu.temp",
      "format": "{value:.0f}°C",
      "font_size": 40,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [
        {
          "above": 75,
          "color": "@warn"
        },
        {
          "above": 88,
          "color": "@krit"
        }
      ],
      "needs": "gpu.load"
    },
    {
      "type": "metric",
      "id": "gpu-power",
      "x": 266,
      "y": 1732,
      "sensor": "gpu.power",
      "format": "{value:.0f} W",
      "font_size": 24,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "gpu.load",
      "smooth": true
    },
    {
      "type": "gauge",
      "id": "disk-ring",
      "x": 42,
      "y": 1640,
      "w": 190,
      "h": 190,
      "sensor": "disk.load",
      "thickness": 16,
      "color": "@disk",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "!gpu.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "disk-load",
      "x": 137,
      "y": 1692,
      "sensor": "disk.load",
      "format": "{value:.0f}%",
      "font_size": 50,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "!gpu.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "disk-label",
      "x": 137,
      "y": 1758,
      "text": "DISK",
      "font_size": 17,
      "color": "@disk",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "!gpu.load"
    },
    {
      "type": "metric",
      "id": "disk-used",
      "x": 266,
      "y": 1674,
      "sensor": "disk.used",
      "format": "{value:.0f} GB",
      "font_size": 40,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [],
      "needs": "!gpu.load"
    },
    {
      "type": "metric",
      "id": "disk-total",
      "x": 266,
      "y": 1732,
      "sensor": "disk.total",
      "format": "/ {value:.0f} GB",
      "smooth": true,
      "font_size": 24,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "left",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "!gpu.load"
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 266,
      "y": 1780,
      "sensor": "gpu.name",
      "format": "{value}",
      "font_size": 18,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "tabular": false,
      "align": "left",
      "max_width": 190,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "gpu.load"
    }
  ]
}
