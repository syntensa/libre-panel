{
  "format": "libre-panel-theme/1",
  "name": "Lumen",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Lumen beside its companion on a second panel: the time, the weather, the processor, graphics card and memory and the network; the fans, every core and the other temperatures are on the companion.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 96,
    "rows": 48,
    "gap": 1,
    "margin": 16
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "frame-mid",
      "x": 743,
      "y": 34,
      "w": 552,
      "h": 430,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 17,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-rings",
      "x": 1315,
      "y": 34,
      "w": 570,
      "h": 308,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 17,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-net",
      "x": 1315,
      "y": 360,
      "w": 570,
      "h": 104,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 1,
      "radius": 7,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 1,
      "row": 0,
      "cols": 35,
      "rows": 48,
      "items": "",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 993,
      "y": 25,
      "format": "%H:%M",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 138,
      "color": "@text",
      "align": "center",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1186,
      "y": 55,
      "format": "%S",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 41,
      "color": "@accent",
      "glow": 0.6,
      "glow_radius": 9
    },
    {
      "type": "clock",
      "id": "date",
      "x": 993,
      "y": 179,
      "format": "%A · %d %B",
      "uppercase": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 20,
      "color": "@text3",
      "letter_spacing": 2.8,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "text",
      "id": "legend-cpu",
      "x": 803,
      "y": 222,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@cpu",
      "letter_spacing": 1.8,
      "tabular": false
    },
    {
      "type": "text",
      "id": "legend-gpu",
      "x": 860,
      "y": 222,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@gpu",
      "letter_spacing": 1.8,
      "tabular": false,
      "needs": "gpu.load"
    },
    {
      "type": "text",
      "id": "legend-span",
      "x": 1235,
      "y": 222,
      "text": "60 S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@dim",
      "letter_spacing": 1.8,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "rect",
      "id": "graph-base",
      "x": 803,
      "y": 448,
      "w": 433,
      "h": 1,
      "color": "@line"
    },
    {
      "type": "graph",
      "id": "gpu-graph",
      "x": 803,
      "y": 246,
      "w": 433,
      "h": 202,
      "sensor": "gpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@gpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.4,
      "glow_radius": 6,
      "needs": "gpu.load"
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 803,
      "y": 246,
      "w": 433,
      "h": 202,
      "sensor": "cpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@cpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 6
    },
    {
      "type": "module",
      "id": "cpu-ring",
      "module": "instrument",
      "col": 67,
      "row": 1,
      "cols": 9,
      "rows": 30,
      "source": "cpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 1423,
      "y": 314,
      "sensor": "cpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 166,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "gpu-ring",
      "module": "instrument",
      "col": 76,
      "row": 1,
      "cols": 9,
      "rows": 30,
      "source": "gpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 1600,
      "y": 314,
      "sensor": "gpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 166,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "mem-ring",
      "module": "instrument",
      "col": 85,
      "row": 1,
      "cols": 9,
      "rows": 30,
      "source": "mem",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 1777,
      "y": 314,
      "sensor": "mem.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 166,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "net",
      "module": "netcard",
      "col": 67,
      "row": 37,
      "cols": 27,
      "rows": 10,
      "card": "off"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
