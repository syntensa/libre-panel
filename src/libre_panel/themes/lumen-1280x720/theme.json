{
  "format": "libre-panel-theme/1",
  "name": "Lumen 5.2″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Lumen laid out for the 5.2\" (1280x720): what plays (the weather when nothing does, the day while there is none) over the fans and the network; beside them the time, the load of the last minute and lit rings for CPU, GPU and RAM named after your hardware.",
  "display": {
    "model": "turing-5.2-usb",
    "orientation": "landscape",
    "width": 1280,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 64,
    "rows": 72,
    "gap": 1,
    "margin": 20
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 1,
      "row": 0,
      "cols": 23,
      "rows": 38,
      "items": "playback\nforecast\ndate",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 861,
      "y": 4,
      "format": "%H:%M",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 150,
      "color": "@text",
      "align": "center",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1068,
      "y": 37,
      "format": "%S",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 44,
      "color": "@accent",
      "glow": 0.6,
      "glow_radius": 10
    },
    {
      "type": "clock",
      "id": "date",
      "x": 861,
      "y": 171,
      "format": "%A · %d %B",
      "uppercase": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "letter_spacing": 3,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "text",
      "id": "legend-cpu",
      "x": 524,
      "y": 207,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@cpu",
      "letter_spacing": 2,
      "tabular": false
    },
    {
      "type": "text",
      "id": "legend-gpu",
      "x": 582,
      "y": 207,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@gpu",
      "letter_spacing": 2,
      "tabular": false,
      "needs": "gpu.load"
    },
    {
      "type": "text",
      "id": "legend-span",
      "x": 1260,
      "y": 207,
      "text": "60 S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 15,
      "color": "@dim",
      "letter_spacing": 2,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "rect",
      "id": "graph-base",
      "x": 524,
      "y": 313,
      "w": 736,
      "h": 1,
      "color": "@line"
    },
    {
      "type": "graph",
      "id": "gpu-graph",
      "x": 524,
      "y": 229,
      "w": 736,
      "h": 84,
      "sensor": "gpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@gpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.4,
      "glow_radius": 6,
      "needs": "gpu.load"
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 524,
      "y": 229,
      "w": 736,
      "h": 84,
      "sensor": "cpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@cpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 6
    },
    {
      "type": "fan",
      "id": "fan-1",
      "x": 39,
      "y": 391,
      "w": 44,
      "h": 44,
      "sensor": "gpu.fan",
      "color": "@gpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-name",
      "x": 89,
      "y": 389,
      "sensor": "gpu.fan",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 59,
      "fit": "ellipsis",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-rpm",
      "x": 89,
      "y": 407,
      "sensor": "gpu.fan",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 22,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "gpu.fan"
    },
    {
      "type": "fan",
      "id": "fan-2",
      "x": 150,
      "y": 391,
      "w": 44,
      "h": 44,
      "sensor": "fan.lpc.fan_1",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-name",
      "x": 200,
      "y": 389,
      "sensor": "fan.lpc.fan_1",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 59,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-rpm",
      "x": 200,
      "y": 407,
      "sensor": "fan.lpc.fan_1",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 22,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "fan",
      "id": "fan-3",
      "x": 261,
      "y": 391,
      "w": 44,
      "h": 44,
      "sensor": "fan.lpc.fan_2",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-name",
      "x": 311,
      "y": 389,
      "sensor": "fan.lpc.fan_2",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 59,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-rpm",
      "x": 311,
      "y": 407,
      "sensor": "fan.lpc.fan_2",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 22,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "fan",
      "id": "fan-4",
      "x": 372,
      "y": 391,
      "w": 44,
      "h": 44,
      "sensor": "fan.lpc.fan_3",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-name",
      "x": 422,
      "y": 389,
      "sensor": "fan.lpc.fan_3",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 59,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-rpm",
      "x": 422,
      "y": 407,
      "sensor": "fan.lpc.fan_3",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 22,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "list",
      "id": "fans",
      "x": 39,
      "y": 391,
      "w": 445,
      "h": 44,
      "items": "fan.*",
      "style": "rows",
      "columns": 3,
      "max_items": 3,
      "sort": "none",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "label_font": "builtin:Barlow-Medium",
      "font_size": 22,
      "uppercase": true,
      "color": "@text",
      "muted": "@text3",
      "color2": "@cpu",
      "levels": false,
      "empty": "",
      "needs": "!gpu.fan, !fan.lpc.fan_1"
    },
    {
      "type": "module",
      "id": "cpu-ring",
      "module": "instrument",
      "col": 25,
      "row": 32,
      "cols": 13,
      "rows": 37,
      "source": "cpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 630,
      "y": 675,
      "sensor": "cpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 241,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "gpu-ring",
      "module": "instrument",
      "col": 38,
      "row": 32,
      "cols": 13,
      "rows": 37,
      "source": "gpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 882,
      "y": 675,
      "sensor": "gpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 241,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "mem-ring",
      "module": "instrument",
      "col": 51,
      "row": 32,
      "cols": 13,
      "rows": 37,
      "source": "mem",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 1134,
      "y": 675,
      "sensor": "mem.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 241,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "net",
      "module": "netcard",
      "col": 0,
      "row": 46,
      "cols": 25,
      "rows": 26,
      "card": "off"
    }
  ]
}
