{
  "format": "libre-panel-theme/1",
  "name": "Almanac",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Almanac for round panels of 480x480: the time large, the weekday, the date and the week, the minute round the rim.",
  "display": {
    "model": "turing-2.8-usb",
    "orientation": "landscape",
    "width": 480,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": null
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "ground",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "color": "@bg2",
      "color2": "@bg",
      "locked": true
    },
    {
      "type": "rect",
      "id": "groove",
      "x": 4,
      "y": 4,
      "w": 472,
      "h": 472,
      "radius": 236,
      "color": "#00000000",
      "outline": "@line",
      "outline_width": 2,
      "locked": true
    },
    {
      "type": "gauge",
      "id": "seconds-rim",
      "x": 13,
      "y": 13,
      "w": 454,
      "h": 454,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "start_angle": 270,
      "end_angle": 630,
      "thickness": 5,
      "color": "@accent",
      "background": "#00000000",
      "glow": 0.7,
      "glow_radius": 6,
      "smooth": false
    },
    {
      "type": "clock",
      "id": "weekday",
      "x": 240,
      "y": 104,
      "format": "%A",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "color": "@accent",
      "align": "center",
      "uppercase": true,
      "letter_spacing": 4,
      "tabular": false,
      "glow": 0.5,
      "glow_radius": 8
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 240,
      "y": 132,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 124,
      "color": "@text",
      "align": "center",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "date",
      "x": 240,
      "y": 284,
      "format": "%d %B %Y",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text2",
      "align": "center",
      "tabular": false
    },
    {
      "type": "text",
      "id": "week",
      "x": 236,
      "y": 336,
      "text": "Week",
      "font": "builtin:Barlow-Medium",
      "font_size": 18,
      "color": "@text3",
      "align": "right",
      "tabular": false,
      "translate": true,
      "uppercase": true,
      "letter_spacing": 2
    },
    {
      "type": "clock",
      "id": "week-number",
      "x": 244,
      "y": 336,
      "format": "%V",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 18,
      "color": "@accent",
      "align": "left",
      "tabular": false
    }
  ]
}
