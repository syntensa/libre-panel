{
  "format": "libre-panel-theme/1",
  "name": "Encore",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Encore for round panels of 480x480: the cover in a ring that fills as the track plays, the title and the artist below it, the cover's colours behind it all.",
  "display": {
    "model": "turing-2.8-usb",
    "orientation": "landscape",
    "width": 480,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": null
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "ground",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "color": "@bg2",
      "color2": "@bg",
      "locked": true
    },
    {
      "type": "rect",
      "id": "groove",
      "x": 4,
      "y": 4,
      "w": 472,
      "h": 472,
      "radius": 236,
      "color": "#00000000",
      "outline": "@line",
      "outline_width": 2,
      "locked": true
    },
    {
      "type": "image",
      "id": "ambient",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "src": "@media.cover",
      "fit": "cover",
      "blur": 40,
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "veil",
      "x": 0,
      "y": 0,
      "w": 480,
      "h": 480,
      "color": "#0A0E13B8",
      "needs": "media.title"
    },
    {
      "type": "gauge",
      "id": "progress",
      "x": 133,
      "y": 40,
      "w": 214,
      "h": 214,
      "sensor": "media.progress",
      "min": 0,
      "max": 1,
      "start_angle": 270,
      "end_angle": 630,
      "thickness": 5,
      "color": "@accent",
      "background": "#ffffff1a",
      "glow": 0.6,
      "glow_radius": 8,
      "needs": "media.title"
    },
    {
      "type": "image",
      "id": "cover",
      "x": 147,
      "y": 54,
      "w": 186,
      "h": 186,
      "src": "@media.cover",
      "fit": "cover",
      "radius": 93,
      "needs": "media.title"
    },
    {
      "type": "icon",
      "id": "cover-icon",
      "x": 210,
      "y": 117,
      "icon": "play",
      "size": 60,
      "color": "@dim",
      "needs": "!@media.cover, media.title"
    },
    {
      "type": "metric",
      "id": "title",
      "x": 240,
      "y": 266,
      "sensor": "media.title",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 30,
      "color": "@text",
      "align": "center",
      "max_width": 330,
      "fit": "shrink",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "artist",
      "x": 240,
      "y": 306,
      "sensor": "media.artist",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 20,
      "color": "@text2",
      "align": "center",
      "max_width": 300,
      "fit": "ellipsis",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "position",
      "x": 156,
      "y": 344,
      "sensor": "media.position",
      "format": "{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 17,
      "color": "@text3",
      "align": "left",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "left",
      "x": 324,
      "y": 344,
      "sensor": "media.remaining",
      "format": "-{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 17,
      "color": "@text3",
      "align": "right",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "app",
      "x": 240,
      "y": 344,
      "sensor": "media.source",
      "format": "{value:upper}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@dim",
      "align": "center",
      "letter_spacing": 2,
      "needs": "media.title",
      "max_width": 110,
      "fit": "ellipsis"
    },
    {
      "type": "clock",
      "id": "clock-small",
      "x": 240,
      "y": 384,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 30,
      "color": "@text2",
      "align": "center",
      "needs": "media.title"
    },
    {
      "type": "clock",
      "id": "clock-idle",
      "x": 240,
      "y": 140,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 96,
      "color": "@text",
      "align": "center",
      "needs": "!media.title",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "text",
      "id": "idle",
      "x": 240,
      "y": 268,
      "text": "Nothing playing",
      "translate": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "align": "center",
      "needs": "!media.title"
    }
  ]
}
