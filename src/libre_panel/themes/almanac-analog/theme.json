{
  "format": "libre-panel-theme/1",
  "name": "Almanac Analog",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Libre Panel's clock face for 8.8\" and 9.2\" bars: a face whose second hand glides to each second, the time and the date beside it, and the month with today marked. Almanac shows the time in digits instead.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 48,
    "gap": 1,
    "margin": 16
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "frame-clock",
      "x": 24,
      "y": 24,
      "w": 1076,
      "h": 432,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 17,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "analog",
      "id": "face",
      "x": 156,
      "y": 42,
      "w": 396,
      "h": 396,
      "color": "@text",
      "color2": "@accent",
      "face": "#111821",
      "marks": "@dim",
      "seconds": true,
      "hand": "glide",
      "glow": 0.15,
      "glow_radius": 11
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 604,
      "y": 106,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 117,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 925,
      "y": 130,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 37,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 9
    },
    {
      "type": "clock",
      "id": "weekday",
      "x": 512,
      "y": 257,
      "format": "%A",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 34,
      "color": "@text2",
      "tabular": false
    },
    {
      "type": "clock",
      "id": "date",
      "x": 604,
      "y": 304,
      "format": "%d %B %Y",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text3",
      "uppercase": true,
      "letter_spacing": 2.8,
      "tabular": false
    },
    {
      "type": "rect",
      "id": "month-card",
      "x": 1120,
      "y": 24,
      "w": 776,
      "h": 432,
      "color": "#0D1219E6",
      "radius": 17,
      "outline": "@line",
      "outline_width": 2
    },
    {
      "type": "rect",
      "id": "frame-month",
      "x": 1120,
      "y": 24,
      "w": 776,
      "h": 432,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 17,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "clock",
      "id": "month",
      "x": 1156,
      "y": 57,
      "format": "%B %Y",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@accent",
      "uppercase": true,
      "letter_spacing": 4,
      "tabular": false
    },
    {
      "type": "clock",
      "id": "week",
      "x": 1860,
      "y": 57,
      "format": "%V",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text2",
      "letter_spacing": 2,
      "align": "right"
    },
    {
      "type": "text",
      "id": "week-label",
      "x": 1817,
      "y": 57,
      "text": "Week",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@dim",
      "tabular": false,
      "translate": true,
      "uppercase": true,
      "letter_spacing": 4,
      "align": "right"
    },
    {
      "type": "calendar",
      "id": "days",
      "x": 1148,
      "y": 110,
      "w": 720,
      "h": 322,
      "font": "builtin:Barlow-Medium",
      "font_size": 27,
      "color": "@text2",
      "color2": "@accent",
      "muted": "@dim"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
