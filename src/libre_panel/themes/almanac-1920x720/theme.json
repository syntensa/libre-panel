{
  "format": "libre-panel-theme/1",
  "name": "Almanac 12.3″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Almanac laid out for the 12.3\" (1920x720): the time, large, and the month with its week; larger type for the larger panel.",
  "display": {
    "model": "turing-12.3-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 72,
    "gap": 1,
    "margin": 16
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "frame-clock",
      "x": 24,
      "y": 24,
      "w": 1076,
      "h": 672,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 25,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 92,
      "y": 107,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 300,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 907,
      "y": 169,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 91,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 12
    },
    {
      "type": "clock",
      "id": "date",
      "x": 552,
      "y": 452,
      "format": "%A · %d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 36,
      "color": "@text2",
      "uppercase": true,
      "letter_spacing": 4,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "rect",
      "id": "seconds-groove",
      "x": 92,
      "y": 529,
      "w": 919,
      "h": 2,
      "color": "@track"
    },
    {
      "type": "bar",
      "id": "seconds-run",
      "x": 92,
      "y": 529,
      "w": 919,
      "h": 2,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "color": "@accent",
      "background": null,
      "radius": 0,
      "smooth": false,
      "end_dot": 4.5
    },
    {
      "type": "rect",
      "id": "month-card",
      "x": 1120,
      "y": 24,
      "w": 776,
      "h": 672,
      "color": "#0D1219E6",
      "radius": 25,
      "outline": "@line",
      "outline_width": 2
    },
    {
      "type": "rect",
      "id": "frame-month",
      "x": 1120,
      "y": 24,
      "w": 776,
      "h": 672,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 25,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "clock",
      "id": "month",
      "x": 1156,
      "y": 66,
      "format": "%B %Y",
      "font": "builtin:Barlow-Medium",
      "font_size": 30,
      "color": "@accent",
      "uppercase": true,
      "letter_spacing": 4,
      "tabular": false
    },
    {
      "type": "clock",
      "id": "week",
      "x": 1860,
      "y": 66,
      "format": "%V",
      "font": "builtin:Barlow-Medium",
      "font_size": 30,
      "color": "@text2",
      "letter_spacing": 2,
      "align": "right"
    },
    {
      "type": "text",
      "id": "week-label",
      "x": 1808,
      "y": 66,
      "text": "Week",
      "font": "builtin:Barlow-Medium",
      "font_size": 30,
      "color": "@dim",
      "tabular": false,
      "translate": true,
      "uppercase": true,
      "letter_spacing": 4,
      "align": "right"
    },
    {
      "type": "calendar",
      "id": "days",
      "x": 1148,
      "y": 136,
      "w": 720,
      "h": 530,
      "font": "builtin:Barlow-Medium",
      "font_size": 36,
      "color": "@text2",
      "color2": "@accent",
      "muted": "@dim"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
