    "cpu_fill": "#13E5D769",
    "mem_frame": "#E0A8FFB9",
    "mem_mark": "#E0A8FFA5",
    "mem_line": "#E0A8FF46",
    "mem_fill": "#E0A8FF69",
    "gpu_frame": "#A3AEFFB9",
    "gpu_mark": "#A3AEFFA5",
    "gpu_line": "#A3AEFF46",
    "gpu_fill": "#A3AEFF69",
    "net_frame": "#7EE8A6B9",
    "net_mark": "#7EE8A6A5",
    "net_line": "#7EE8A646",
    "net_fill": "#7EE8A669",
    "neutral_frame": "#EEF6FFB9",
    "neutral_mark": "#EEF6FFA5",
    "neutral_line": "#EEF6FF46",
    "neutral_fill": "#EEF6FF69"
