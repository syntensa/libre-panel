    "rule": "#32475E",
    "rule_strong": "#496480",
    "text": "#EEF6FF",
    "text2": "#B8CAE0",
    "text3": "#8CA0B8",
    "accent": "#13E5D7",
    "accent_deep": "#19746E",
    "ok": "#6FE3B5",
    "warn": "#FFCB6B",
    "crit": "#FF7A85",
    "cpu": "#13E5D7",
    "mem": "#E0A8FF",
    "gpu": "#A3AEFF",
    "net": "#7EE8A6",
