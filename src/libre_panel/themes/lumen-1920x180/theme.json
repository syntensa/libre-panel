{
  "format": "libre-panel-theme/1",
  "name": "Lumen",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Lumen for the three fan screens of the JONSBO ZC-360 (1920x180): what plays (the weather when nothing does, the day while there is none), the time, and lit rings for CPU and GPU, one part on each screen.",
  "display": {
    "model": "jonsbo-zc360",
    "orientation": "landscape",
    "width": 1920,
    "height": 180
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 96,
    "rows": 12,
    "gap": 0,
    "margin": 0
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 1,
      "row": 1,
      "cols": 30,
      "rows": 10,
      "items": "playback\nforecast\ndate",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "module",
      "id": "clock",
      "module": "clock",
      "col": 33,
      "row": 1,
      "cols": 30,
      "rows": 10
    },
    {
      "type": "module",
      "id": "cpu-ring",
      "module": "instrument",
      "col": 65,
      "row": 1,
      "cols": 15,
      "rows": 10,
      "source": "cpu",
      "card": "off"
    },
    {
      "type": "module",
      "id": "gpu-ring",
      "module": "instrument",
      "col": 80,
      "row": 1,
      "cols": 15,
      "rows": 10,
      "source": "gpu",
      "card": "off"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
