{
  "format": "libre-panel-theme/1",
  "name": "Lumen",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Libre Panel's signature screen for 8.8\" and 9.2\" bars: what plays (the weather when nothing does, the day while there is none), the time with the load of the last minute and the fans, and lit rings for CPU, GPU and RAM named after your hardware, over the network (a download while one runs).",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 48,
    "gap": 1,
    "margin": 16
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 0,
      "row": 0,
      "cols": 18,
      "rows": 48,
      "items": "playback\nforecast\ndate",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 1006,
      "y": 1,
      "format": "%H:%M",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 150,
      "color": "@text",
      "align": "center",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1215,
      "y": 33,
      "format": "%S",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 44,
      "color": "@accent",
      "glow": 0.6,
      "glow_radius": 10
    },
    {
      "type": "clock",
      "id": "date",
      "x": 1006,
      "y": 168,
      "format": "%A · %d %B",
      "uppercase": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "letter_spacing": 3,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "text",
      "id": "legend-cpu",
      "x": 799,
      "y": 215,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 14,
      "color": "@cpu",
      "letter_spacing": 2,
      "tabular": false
    },
    {
      "type": "text",
      "id": "legend-gpu",
      "x": 861,
      "y": 215,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 14,
      "color": "@gpu",
      "letter_spacing": 2,
      "tabular": false,
      "needs": "gpu.load"
    },
    {
      "type": "text",
      "id": "legend-span",
      "x": 1269,
      "y": 215,
      "text": "60 S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 14,
      "color": "@dim",
      "letter_spacing": 2,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "rect",
      "id": "graph-base",
      "x": 799,
      "y": 384,
      "w": 470,
      "h": 1,
      "color": "@line"
    },
    {
      "type": "graph",
      "id": "gpu-graph",
      "x": 799,
      "y": 241,
      "w": 470,
      "h": 143,
      "sensor": "gpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@gpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.4,
      "glow_radius": 6,
      "needs": "gpu.load"
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 799,
      "y": 241,
      "w": 470,
      "h": 143,
      "sensor": "cpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@cpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 6
    },
    {
      "type": "fan",
      "id": "fan-1",
      "x": 799,
      "y": 418,
      "w": 42,
      "h": 42,
      "sensor": "gpu.fan",
      "color": "@gpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-name",
      "x": 849,
      "y": 417,
      "sensor": "gpu.fan",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 66,
      "fit": "ellipsis",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-rpm",
      "x": 849,
      "y": 434,
      "sensor": "gpu.fan",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "gpu.fan"
    },
    {
      "type": "fan",
      "id": "fan-2",
      "x": 920,
      "y": 418,
      "w": 42,
      "h": 42,
      "sensor": "fan.lpc.fan_1",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-name",
      "x": 970,
      "y": 417,
      "sensor": "fan.lpc.fan_1",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 66,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-rpm",
      "x": 970,
      "y": 434,
      "sensor": "fan.lpc.fan_1",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "fan",
      "id": "fan-3",
      "x": 1042,
      "y": 418,
      "w": 42,
      "h": 42,
      "sensor": "fan.lpc.fan_2",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-name",
      "x": 1092,
      "y": 417,
      "sensor": "fan.lpc.fan_2",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 66,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-rpm",
      "x": 1092,
      "y": 434,
      "sensor": "fan.lpc.fan_2",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "fan",
      "id": "fan-4",
      "x": 1164,
      "y": 418,
      "w": 42,
      "h": 42,
      "sensor": "fan.lpc.fan_3",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-name",
      "x": 1214,
      "y": 417,
      "sensor": "fan.lpc.fan_3",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 66,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-rpm",
      "x": 1214,
      "y": 434,
      "sensor": "fan.lpc.fan_3",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 20,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "list",
      "id": "fans",
      "x": 799,
      "y": 418,
      "w": 470,
      "h": 42,
      "items": "fan.*",
      "style": "rows",
      "columns": 3,
      "max_items": 3,
      "sort": "none",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "label_font": "builtin:Barlow-Medium",
      "font_size": 20,
      "uppercase": true,
      "color": "@text",
      "muted": "@text3",
      "color2": "@cpu",
      "levels": false,
      "empty": "",
      "needs": "!gpu.fan, !fan.lpc.fan_1"
    },
    {
      "type": "module",
      "id": "cpu-ring",
      "module": "instrument",
      "col": 33,
      "row": 0,
      "cols": 5,
      "rows": 33,
      "source": "cpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 1412,
      "y": 329,
      "sensor": "cpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 185,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "gpu-ring",
      "module": "instrument",
      "col": 38,
      "row": 0,
      "cols": 5,
      "rows": 33,
      "source": "gpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 1609,
      "y": 329,
      "sensor": "gpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 186,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "mem-ring",
      "module": "instrument",
      "col": 43,
      "row": 0,
      "cols": 5,
      "rows": 33,
      "source": "mem",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 1806,
      "y": 329,
      "sensor": "mem.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 186,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "net",
      "module": "netcard",
      "col": 33,
      "row": 36,
      "cols": 15,
      "rows": 12,
      "card": "off"
    }
  ]
}
