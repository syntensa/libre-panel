{
  "format": "libre-panel-theme/1",
  "name": "Encore 0.96″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Encore for tiny panels (160x80, WeAct 0.96\"): the cover beside the title and the artist, a line that fills as the track plays; while nothing plays, the time.",
  "display": {
    "model": "weact-0.96",
    "orientation": "landscape",
    "width": 160,
    "height": 80
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "gradient": [
      "@bg",
      "@bg2"
    ]
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "widgets": [
    {
      "type": "image",
      "id": "cover",
      "x": 6,
      "y": 8,
      "w": 56,
      "h": 56,
      "src": "@media.cover",
      "fit": "cover",
      "radius": 6,
      "needs": "media.title"
    },
    {
      "type": "icon",
      "id": "cover-icon",
      "x": 20,
      "y": 22,
      "icon": "play",
      "size": 28,
      "color": "@dim",
      "needs": "!@media.cover, media.title"
    },
    {
      "type": "metric",
      "id": "title",
      "x": 70,
      "y": 12,
      "sensor": "media.title",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 14,
      "color": "@text",
      "max_width": 84,
      "fit": "ellipsis",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "artist",
      "x": 70,
      "y": 32,
      "sensor": "media.artist",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 12,
      "color": "@text2",
      "max_width": 84,
      "fit": "ellipsis",
      "needs": "media.title"
    },
    {
      "type": "bar",
      "id": "progress",
      "x": 70,
      "y": 58,
      "w": 84,
      "h": 3,
      "sensor": "media.progress",
      "min": 0,
      "max": 1,
      "color": "@accent",
      "background": "#ffffff1a",
      "radius": 1,
      "smooth": true,
      "needs": "media.title"
    },
    {
      "type": "clock",
      "id": "clock-idle",
      "x": 80,
      "y": 10,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 34,
      "color": "@text",
      "digits": "roll",
      "align": "center",
      "needs": "!media.title"
    },
    {
      "type": "text",
      "id": "idle",
      "x": 80,
      "y": 56,
      "text": "Nothing playing",
      "translate": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 12,
      "color": "@text3",
      "align": "center",
      "tabular": false,
      "needs": "!media.title"
    }
  ]
}
