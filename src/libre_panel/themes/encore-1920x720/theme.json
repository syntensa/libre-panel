{
  "format": "libre-panel-theme/1",
  "name": "Encore 12.3″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Encore laid out for the 12.3\" (1920x720): what plays, large, with its cover, the time and the volume; larger type for the larger panel.",
  "display": {
    "model": "turing-12.3-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 72,
    "gap": 1,
    "margin": 16
  },
  "toast": {
    "off": [
      "volume"
    ]
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "image",
      "id": "ambient",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 720,
      "src": "@media.cover",
      "fit": "cover",
      "blur": 56,
      "opacity": 0.9,
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "veil",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 720,
      "color": "#0A0E1338",
      "color2": "#0A0E13F2",
      "gradient": "horizontal",
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "frame-text",
      "x": 664,
      "y": 60,
      "w": 628,
      "h": 600,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 25,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-time",
      "x": 1316,
      "y": 60,
      "w": 580,
      "h": 600,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 25,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "cover-frame",
      "x": 40,
      "y": 60,
      "w": 600,
      "h": 600,
      "color": "#121A24",
      "radius": 18,
      "outline": "@line",
      "needs": "!@media.cover"
    },
    {
      "type": "icon",
      "id": "cover-icon",
      "x": 244,
      "y": 264,
      "icon": "music",
      "size": 192,
      "color": "@dim",
      "stroke": 1.6,
      "needs": "!@media.cover"
    },
    {
      "type": "image",
      "id": "cover",
      "x": 40,
      "y": 60,
      "w": 600,
      "h": 600,
      "src": "@media.cover",
      "fit": "cover",
      "radius": 18,
      "shadow": "#00000099",
      "shadow_offset": 6,
      "shadow_blur": 22
    },
    {
      "type": "icon",
      "id": "playing-sign",
      "x": 688,
      "y": 104,
      "icon": "play",
      "size": 28,
      "color": "@cover",
      "needs": "media.playing=1, media.title"
    },
    {
      "type": "icon",
      "id": "paused-sign",
      "x": 688,
      "y": 104,
      "icon": "pause",
      "size": 28,
      "color": "@cover",
      "needs": "media.playing=0, media.title"
    },
    {
      "type": "metric",
      "id": "state",
      "x": 728,
      "y": 100,
      "sensor": "media.state",
      "format": "{value:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 27,
      "color": "@cover",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "max_width": 552,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "title",
      "x": 688,
      "y": 146,
      "sensor": "media.title",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 80,
      "color": "@text",
      "tabular": false,
      "fallback": "",
      "max_width": 580,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "artist",
      "x": 688,
      "y": 268,
      "sensor": "media.artist",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 46,
      "color": "@text2",
      "tabular": false,
      "fallback": "",
      "max_width": 580,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "album",
      "x": 688,
      "y": 336,
      "sensor": "media.album",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 33,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 580,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "image",
      "id": "app-icon",
      "x": 688,
      "y": 398,
      "w": 40,
      "h": 40,
      "src": "@media.app_icon",
      "fit": "contain",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "app",
      "x": 742,
      "y": 400,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 28,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 526,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "@media.app_icon, media.title"
    },
    {
      "type": "metric",
      "id": "app-bare",
      "x": 688,
      "y": 400,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 28,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 580,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "!@media.app_icon, media.title"
    },
    {
      "type": "bar",
      "id": "progress",
      "x": 688,
      "y": 566,
      "w": 580,
      "h": 10,
      "sensor": "media.progress",
      "min": 0,
      "max": 1,
      "color": "@cover",
      "background": "@track",
      "radius": 4,
      "smooth": true,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 10,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "position",
      "x": 688,
      "y": 596,
      "sensor": "media.position",
      "format": "{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 30,
      "color": "@text3",
      "max_width": 293,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "left",
      "x": 1268,
      "y": 596,
      "sensor": "media.remaining",
      "format": "-{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 30,
      "color": "@text3",
      "align": "right",
      "max_width": 293,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "text",
      "id": "idle",
      "x": 688,
      "y": 300,
      "text": "Nothing playing",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 56,
      "color": "@text2",
      "tabular": false,
      "translate": true,
      "needs": "!media.title"
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 1338,
      "y": 41,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 175,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1814,
      "y": 79,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 51,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 9
    },
    {
      "type": "clock",
      "id": "date",
      "x": 1606,
      "y": 242,
      "format": "%A · %d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 25,
      "color": "@text3",
      "uppercase": true,
      "letter_spacing": 2.8,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "rect",
      "id": "seconds-groove",
      "x": 1338,
      "y": 291,
      "w": 536,
      "h": 2,
      "color": "@track"
    },
    {
      "type": "bar",
      "id": "seconds-run",
      "x": 1338,
      "y": 291,
      "w": 536,
      "h": 2,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "color": "@accent",
      "background": null,
      "radius": 0,
      "smooth": false,
      "end_dot": 4
    },
    {
      "type": "module",
      "id": "volume",
      "module": "volume",
      "col": 34,
      "row": 37,
      "cols": 13,
      "rows": 28,
      "card": "off"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
