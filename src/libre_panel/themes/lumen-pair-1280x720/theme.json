{
  "format": "libre-panel-theme/1",
  "name": "Lumen 5.2″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Lumen beside its companion on a second panel: the time, the weather, the processor, graphics card and memory and the network; the fans, every core and the other temperatures are on the companion.",
  "display": {
    "model": "turing-5.2-usb",
    "orientation": "landscape",
    "width": 1280,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 64,
    "rows": 72,
    "gap": 1,
    "margin": 20
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "frame-top",
      "x": 504,
      "y": 20,
      "w": 737,
      "h": 282,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 20,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-rings",
      "x": 504,
      "y": 322,
      "w": 737,
      "h": 378,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 25,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-left",
      "x": 39,
      "y": 398,
      "w": 445,
      "h": 302,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 21,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 1,
      "row": 0,
      "cols": 23,
      "rows": 38,
      "items": "playback\nforecast\ndate",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 845,
      "y": 11,
      "format": "%H:%M",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 134,
      "color": "@text",
      "align": "center",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1030,
      "y": 40,
      "format": "%S",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 39,
      "color": "@accent",
      "glow": 0.6,
      "glow_radius": 9
    },
    {
      "type": "clock",
      "id": "date",
      "x": 845,
      "y": 160,
      "format": "%A · %d %B",
      "uppercase": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 20,
      "color": "@text3",
      "letter_spacing": 2.7,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "text",
      "id": "legend-cpu",
      "x": 543,
      "y": 192,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@cpu",
      "letter_spacing": 1.8,
      "tabular": false
    },
    {
      "type": "text",
      "id": "legend-gpu",
      "x": 595,
      "y": 192,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@gpu",
      "letter_spacing": 1.8,
      "tabular": false,
      "needs": "gpu.load"
    },
    {
      "type": "text",
      "id": "legend-span",
      "x": 1202,
      "y": 192,
      "text": "60 S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@dim",
      "letter_spacing": 1.8,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "rect",
      "id": "graph-base",
      "x": 543,
      "y": 287,
      "w": 658,
      "h": 1,
      "color": "@line"
    },
    {
      "type": "graph",
      "id": "gpu-graph",
      "x": 543,
      "y": 212,
      "w": 658,
      "h": 75,
      "sensor": "gpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@gpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.4,
      "glow_radius": 5,
      "needs": "gpu.load"
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 543,
      "y": 212,
      "w": 658,
      "h": 75,
      "sensor": "cpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@cpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 5
    },
    {
      "type": "module",
      "id": "cpu-ring",
      "module": "instrument",
      "col": 26,
      "row": 35,
      "cols": 12,
      "rows": 34,
      "source": "cpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 640,
      "y": 676,
      "sensor": "cpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 222,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "gpu-ring",
      "module": "instrument",
      "col": 38,
      "row": 35,
      "cols": 12,
      "rows": 34,
      "source": "gpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 873,
      "y": 676,
      "sensor": "gpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 222,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "mem-ring",
      "module": "instrument",
      "col": 50,
      "row": 35,
      "cols": 12,
      "rows": 34,
      "source": "mem",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 1106,
      "y": 676,
      "sensor": "mem.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "align": "center",
      "max_width": 221,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "net",
      "module": "netcard",
      "col": 2,
      "row": 42,
      "cols": 21,
      "rows": 28,
      "card": "off"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
