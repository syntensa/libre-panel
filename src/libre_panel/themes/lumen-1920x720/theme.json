{
  "format": "libre-panel-theme/1",
  "name": "Lumen 12.3″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Lumen laid out for the 12.3\" (1920x720), each part in a frame (Look switches them off): the weather with the next hours and days (the day while there is none), the time with the load of the last minute and the fans, lit rings for CPU, GPU and RAM named after your hardware, and the network; larger type for the larger panel. What plays has its own screen, Encore.",
  "display": {
    "model": "turing-12.3-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 96,
    "rows": 72,
    "gap": 1,
    "margin": 20
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "frame-mid",
      "x": 587,
      "y": 20,
      "w": 609,
      "h": 680,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 25,
      "needs": "switch.frames",
      "locked": true
    },
    {
      "type": "rect",
      "id": "frame-rings",
      "x": 1215,
      "y": 20,
      "w": 685,
      "h": 436,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 25,
      "needs": "switch.frames",
      "locked": true
    },
    {
      "type": "rect",
      "id": "frame-net",
      "x": 1215,
      "y": 474,
      "w": 685,
      "h": 226,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 1,
      "radius": 16,
      "needs": "switch.frames",
      "locked": true
    },
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 0,
      "row": 0,
      "cols": 28,
      "rows": 72,
      "items": "",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 853,
      "y": 14,
      "format": "%H:%M",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 176,
      "color": "@text",
      "align": "center",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1096,
      "y": 53,
      "format": "%S",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 52,
      "color": "@accent",
      "glow": 0.6,
      "glow_radius": 12
    },
    {
      "type": "clock",
      "id": "date",
      "x": 853,
      "y": 209,
      "format": "%A · %d %B",
      "uppercase": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 28,
      "color": "@text3",
      "letter_spacing": 4,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "text",
      "id": "legend-cpu",
      "x": 608,
      "y": 261,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 18,
      "color": "@cpu",
      "letter_spacing": 2,
      "tabular": false
    },
    {
      "type": "text",
      "id": "legend-gpu",
      "x": 682,
      "y": 261,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 18,
      "color": "@gpu",
      "letter_spacing": 2,
      "tabular": false,
      "needs": "gpu.load"
    },
    {
      "type": "text",
      "id": "legend-span",
      "x": 1175,
      "y": 261,
      "text": "60 S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 18,
      "color": "@dim",
      "letter_spacing": 2,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "rect",
      "id": "graph-base",
      "x": 608,
      "y": 597,
      "w": 567,
      "h": 1,
      "color": "@line"
    },
    {
      "type": "graph",
      "id": "gpu-graph",
      "x": 608,
      "y": 291,
      "w": 567,
      "h": 306,
      "sensor": "gpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@gpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.4,
      "glow_radius": 6,
      "needs": "gpu.load"
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 608,
      "y": 291,
      "w": 567,
      "h": 306,
      "sensor": "cpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@cpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 6
    },
    {
      "type": "fan",
      "id": "fan-1",
      "x": 608,
      "y": 629,
      "w": 50,
      "h": 50,
      "sensor": "gpu.fan",
      "color": "@gpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-name",
      "x": 668,
      "y": 627,
      "sensor": "gpu.fan",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 82,
      "fit": "ellipsis",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-rpm",
      "x": 668,
      "y": 647,
      "sensor": "gpu.fan",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 26,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "gpu.fan"
    },
    {
      "type": "fan",
      "id": "fan-2",
      "x": 750,
      "y": 629,
      "w": 50,
      "h": 50,
      "sensor": "fan.lpc.fan_1",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-name",
      "x": 810,
      "y": 627,
      "sensor": "fan.lpc.fan_1",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 82,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-rpm",
      "x": 810,
      "y": 647,
      "sensor": "fan.lpc.fan_1",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 26,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "fan",
      "id": "fan-3",
      "x": 892,
      "y": 629,
      "w": 50,
      "h": 50,
      "sensor": "fan.lpc.fan_2",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-name",
      "x": 952,
      "y": 627,
      "sensor": "fan.lpc.fan_2",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 82,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-rpm",
      "x": 952,
      "y": 647,
      "sensor": "fan.lpc.fan_2",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 26,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "fan",
      "id": "fan-4",
      "x": 1034,
      "y": 629,
      "w": 50,
      "h": 50,
      "sensor": "fan.lpc.fan_3",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-name",
      "x": 1094,
      "y": 627,
      "sensor": "fan.lpc.fan_3",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 16,
      "color": "@text3",
      "letter_spacing": 1,
      "tabular": false,
      "max_width": 82,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-rpm",
      "x": 1094,
      "y": 647,
      "sensor": "fan.lpc.fan_3",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 26,
      "max_width": 66,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "list",
      "id": "fans",
      "x": 608,
      "y": 629,
      "w": 567,
      "h": 50,
      "items": "fan.*",
      "style": "rows",
      "columns": 3,
      "max_items": 3,
      "sort": "none",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "label_font": "builtin:Barlow-Medium",
      "font_size": 26,
      "uppercase": true,
      "color": "@text",
      "muted": "@text3",
      "color2": "@cpu",
      "levels": false,
      "empty": "",
      "needs": "!gpu.fan, !fan.lpc.fan_1"
    },
    {
      "type": "module",
      "id": "cpu-ring",
      "module": "instrument",
      "col": 62,
      "row": 2,
      "cols": 11,
      "rows": 40,
      "source": "cpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 1343,
      "y": 412,
      "sensor": "cpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text3",
      "align": "center",
      "max_width": 200,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "gpu-ring",
      "module": "instrument",
      "col": 73,
      "row": 2,
      "cols": 11,
      "rows": 40,
      "source": "gpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 1558,
      "y": 412,
      "sensor": "gpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text3",
      "align": "center",
      "max_width": 200,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "mem-ring",
      "module": "instrument",
      "col": 84,
      "row": 2,
      "cols": 11,
      "rows": 40,
      "source": "mem",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 1774,
      "y": 412,
      "sensor": "mem.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text3",
      "align": "center",
      "max_width": 200,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "net",
      "module": "netcard",
      "col": 62,
      "row": 50,
      "cols": 34,
      "rows": 21,
      "card": "off"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
