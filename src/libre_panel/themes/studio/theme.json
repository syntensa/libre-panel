    {
      "type": "metric",
      "id": "gpu-load",
      "x": 1760,
      "y": 92,
      "sensor": "gpu.load",
      "format": "{value:.0f}%",
      "font_size": 54,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "gpu.load"
    },
    {
