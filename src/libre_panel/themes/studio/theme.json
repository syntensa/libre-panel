{
  "format": "libre-panel-theme/1",
  "name": "Studio",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "A calm screen for 8.8\" and 9.2\" bars after SPUR II's Studio: a large clock, a card with what plays (the weather of your location when nothing does, a calendar sheet while there is neither), lit rings for CPU, memory and GPU (the disk on a PC without GPU readings), and the names of your own hardware.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "void": "#000000",
    "base_low": "#060A0F",
    "base": "#0A1119",
    "surf_1": "#14202E",
    "surf_2": "#1F3147",
    "track": "#162332",
    "rule_soft": "#1C2B3C",
    "rule": "#32475E",
    "tx_1": "#EEF6FF",
    "tx_2": "#B8CAE0",
    "tx_3": "#8CA0B8",
    "accent": "#13E5D7",
    "accent_deep": "#19746E",
    "cpu": "#13E5D7",
    "cpu_deep": "#19746E",
    "mem": "#E0A8FF",
    "mem_deep": "#6E4C8F",
    "gpu": "#A3AEFF",
    "gpu_deep": "#4A55A8",
    "net": "#7EE8A6",
    "net_deep": "#2F7A52",
    "disk": "#7EE8A6",
    "disk_deep": "#2F7A52",
    "ok": "#6FE3B5",
    "warn": "#FFCB6B",
    "krit": "#FF7A85",
    "bg": "#0A1119",
    "surface": "#14202E",
    "line": "#32475E",
    "text": "#EEF6FF",
    "text2": "#B8CAE0",
    "text3": "#8CA0B8",
    "crit": "#FF7A85"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@base",
    "image": null
  },
  "refresh_ms": 500,
  "animation": {
    "smoothing_ms": 600
  },
  "widgets": [
    {
      "type": "rect",
      "id": "backdrop",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 480,
      "color": "@base",
      "color2": "@base_low",
      "locked": true
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 44,
      "y": 30,
      "format": "%H:%M",
      "font_size": 180,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "glow": 0.18,
      "glow_radius": 14
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 532,
      "y": 66,
      "format": "%S",
      "font_size": 64,
      "color": "@accent",
      "font": "builtin:Barlow-SemiBold",
      "glow": 0.7,
      "glow_radius": 10
    },
    {
      "type": "rect",
      "id": "signature",
      "x": 54,
      "y": 246,
      "w": 120,
      "h": 4,
      "color": "@accent",
      "radius": 2,
      "glow": 0.7,
      "glow_radius": 8
    },
    {
      "type": "clock",
      "id": "date",
      "x": 52,
      "y": 266,
      "format": "%A · %d %B",
      "font_size": 34,
      "color": "@tx_2",
      "tabular": false,
      "letter_spacing": 1,
      "needs": "weather.temperature"
    },
    {
      "type": "clock",
      "id": "date-music",
      "x": 52,
      "y": 266,
      "format": "%A · %d %B",
      "font_size": 34,
      "color": "@tx_2",
      "tabular": false,
      "letter_spacing": 1,
      "needs": "!weather.temperature, media.title"
    },
    {
      "type": "icon",
      "id": "net.down-icon",
      "x": 54,
      "y": 364,
      "icon": "download",
      "size": 26,
      "color": "@net",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "net.down-value",
      "x": 92,
      "y": 360,
      "sensor": "net.down",
      "format": "{value:bytes}/s",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true
    },
    {
      "type": "icon",
      "id": "net.up-icon",
      "x": 282,
      "y": 364,
      "icon": "upload",
      "size": 26,
      "color": "@net",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "net.up-value",
      "x": 320,
      "y": 360,
      "sensor": "net.up",
      "format": "{value:bytes}/s",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true
    },
    {
      "type": "icon",
      "id": "sys.uptime-icon",
      "x": 510,
      "y": 364,
      "icon": "clock",
      "size": 26,
      "color": "@tx_3",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "sys.uptime-value",
      "x": 548,
      "y": 360,
      "sensor": "sys.uptime",
      "format": "{value:duration}",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 16,
      "row": 2,
      "cols": 14,
      "rows": 38,
      "items": "playback\nforecast\ndate",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "gauge",
      "id": "cpu-ring",
      "x": 1215,
      "y": 34,
      "w": 200,
      "h": 200,
      "sensor": "cpu.load",
      "thickness": 16,
      "color": "@cpu",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "cpu.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "cpu-load",
      "x": 1315,
      "y": 92,
      "sensor": "cpu.load",
      "format": "{value:.0f}%",
      "font_size": 54,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "cpu.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "cpu-label",
      "x": 1315,
      "y": 158,
      "text": "CPU",
      "font_size": 18,
      "color": "@cpu",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "cpu.load"
    },
    {
      "type": "metric",
      "id": "cpu-temp",
      "x": 1315,
      "y": 256,
      "sensor": "cpu.temp",
      "format": "{value:.0f}°C",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [
        {
          "above": 75,
          "color": "@warn"
        },
        {
          "above": 88,
          "color": "@krit"
        }
      ],
      "needs": "cpu.load"
    },
    {
      "type": "metric",
      "id": "cpu-power",
      "x": 1315,
      "y": 296,
      "sensor": "cpu.power",
      "format": "{value:.0f} W",
      "font_size": 22,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "cpu.load",
      "smooth": true
    },
    {
      "type": "gauge",
      "id": "mem-ring",
      "x": 1450,
      "y": 34,
      "w": 200,
      "h": 200,
      "sensor": "mem.load",
      "thickness": 16,
      "color": "@mem",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "mem.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "mem-load",
      "x": 1550,
      "y": 92,
      "sensor": "mem.load",
      "format": "{value:.0f}%",
      "font_size": 54,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "mem.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "mem-label",
      "x": 1550,
      "y": 158,
      "text": "RAM",
      "font_size": 18,
      "color": "@mem",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "mem.load"
    },
    {
      "type": "metric",
      "id": "mem-used",
      "x": 1550,
      "y": 256,
      "sensor": "mem.used",
      "format": "{value:.1f} GB",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [],
      "needs": "mem.load"
    },
    {
      "type": "metric",
      "id": "mem-total",
      "x": 1550,
      "y": 296,
      "sensor": "mem.total",
      "format": "/ {value:.0f} GB",
      "font_size": 22,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "mem.load"
    },
    {
      "type": "gauge",
      "id": "gpu-ring",
      "x": 1685,
      "y": 34,
      "w": 200,
      "h": 200,
      "sensor": "gpu.load",
      "thickness": 16,
      "color": "@gpu",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "gpu.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "gpu-load",
      "x": 1785,
      "y": 92,
      "sensor": "gpu.load",
      "format": "{value:.0f}%",
      "font_size": 54,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "gpu.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "gpu-label",
      "x": 1785,
      "y": 158,
      "text": "GPU",
      "font_size": 18,
      "color": "@gpu",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "gpu.load"
    },
    {
      "type": "metric",
      "id": "gpu-temp",
      "x": 1785,
      "y": 256,
      "sensor": "gpu.temp",
      "format": "{value:.0f}°C",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [
        {
          "above": 75,
          "color": "@warn"
        },
        {
          "above": 88,
          "color": "@krit"
        }
      ],
      "needs": "gpu.load"
    },
    {
      "type": "metric",
      "id": "gpu-power",
      "x": 1785,
      "y": 296,
      "sensor": "gpu.power",
      "format": "{value:.0f} W",
      "font_size": 22,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "gpu.load",
      "smooth": true
    },
    {
      "type": "gauge",
      "id": "disk-ring",
      "x": 1685,
      "y": 34,
      "w": 200,
      "h": 200,
      "sensor": "disk.load",
      "thickness": 16,
      "color": "@disk",
      "background": "@track",
      "cap": "flat",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "!gpu.load",
      "finish": "lit"
    },
    {
      "type": "metric",
      "id": "disk-load",
      "x": 1785,
      "y": 92,
      "sensor": "disk.load",
      "format": "{value:.0f}%",
      "font_size": 54,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "!gpu.load",
      "smooth": true
    },
    {
      "type": "text",
      "id": "disk-label",
      "x": 1785,
      "y": 158,
      "text": "DISK",
      "font_size": 18,
      "color": "@disk",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "!gpu.load"
    },
    {
      "type": "metric",
      "id": "disk-used",
      "x": 1785,
      "y": 256,
      "sensor": "disk.used",
      "format": "{value:.0f} GB",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "smooth": true,
      "color_rules": [],
      "needs": "!gpu.load"
    },
    {
      "type": "metric",
      "id": "disk-total",
      "x": 1785,
      "y": 296,
      "sensor": "disk.total",
      "format": "/ {value:.0f} GB",
      "font_size": 22,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "!gpu.load"
    },
    {
      "type": "rect",
      "id": "names-rule",
      "x": 1215,
      "y": 392,
      "w": 670,
      "h": 1,
      "color": "@rule_soft"
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 1315,
      "y": 410,
      "sensor": "cpu.name",
      "format": "{value}",
      "font_size": 18,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "tabular": false,
      "align": "center",
      "max_width": 220,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": ""
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 1550,
      "y": 410,
      "sensor": "mem.name",
      "format": "{value}",
      "font_size": 18,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "tabular": false,
      "align": "center",
      "max_width": 220,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": ""
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 1785,
      "y": 410,
      "sensor": "gpu.name",
      "format": "{value}",
      "font_size": 18,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "tabular": false,
      "align": "center",
      "max_width": 220,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "gpu.load"
    }
  ],
  "grid": {
    "columns": 48,
    "rows": 48,
    "gap": 1,
    "margin": 22
  },
  "style": {
    "card": "glass",
    "radius": 12,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  }
}
