{
  "format": "libre-panel-theme/1",
  "name": "Studio",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "A calm screen for 8.8\" and 9.2\" bars after SPUR II's Studio: a large clock, a card with the weather of your location (a calendar sheet while there is none), rings for CPU, memory and GPU (the disk on a PC without GPU readings), and the names of your own hardware.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "void": "#000000",
    "base_low": "#060A0F",
    "base": "#0A1119",
    "surf_1": "#14202E",
    "surf_2": "#1F3147",
    "track": "#162332",
    "rule_soft": "#1C2B3C",
    "rule": "#32475E",
    "tx_1": "#EEF6FF",
    "tx_2": "#B8CAE0",
    "tx_3": "#8CA0B8",
    "accent": "#13E5D7",
    "accent_deep": "#19746E",
    "cpu": "#13E5D7",
    "cpu_deep": "#19746E",
    "mem": "#E0A8FF",
    "mem_deep": "#6E4C8F",
    "gpu": "#A3AEFF",
    "gpu_deep": "#4A55A8",
    "net": "#7EE8A6",
    "net_deep": "#2F7A52",
    "disk": "#7EE8A6",
    "disk_deep": "#2F7A52",
    "ok": "#6FE3B5",
    "warn": "#FFCB6B",
    "krit": "#FF7A85"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@base",
    "image": null
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "widgets": [
    {
      "type": "rect",
      "id": "backdrop",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 480,
      "color": "@base",
      "color2": "@base_low",
      "locked": true
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 44,
      "y": 30,
      "format": "%H:%M",
      "font_size": 180,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "glow": 0.18,
      "glow_radius": 14
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 532,
      "y": 66,
      "format": "%S",
      "font_size": 64,
      "color": "@accent",
      "font": "builtin:Barlow-SemiBold",
      "glow": 0.7,
      "glow_radius": 10
    },
    {
      "type": "rect",
      "id": "signature",
      "x": 54,
      "y": 246,
      "w": 120,
      "h": 4,
      "color": "@accent",
      "radius": 2,
      "glow": 0.7,
      "glow_radius": 8
    },
    {
      "type": "clock",
      "id": "date",
      "x": 52,
      "y": 266,
      "format": "%A · %d %B",
      "font_size": 34,
      "color": "@tx_2",
      "tabular": false,
      "letter_spacing": 1,
      "needs": "weather.temperature"
    },
    {
      "type": "icon",
      "id": "net.down-icon",
      "x": 54,
      "y": 364,
      "icon": "download",
      "size": 26,
      "color": "@net",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "net.down-value",
      "x": 92,
      "y": 360,
      "sensor": "net.down",
      "format": "{value:bytes}/s",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true
    },
    {
      "type": "icon",
      "id": "net.up-icon",
      "x": 282,
      "y": 364,
      "icon": "upload",
      "size": 26,
      "color": "@net",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "net.up-value",
      "x": 320,
      "y": 360,
      "sensor": "net.up",
      "format": "{value:bytes}/s",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true
    },
    {
      "type": "icon",
      "id": "sys.uptime-icon",
      "x": 510,
      "y": 364,
      "icon": "clock",
      "size": 26,
      "color": "@tx_3",
      "stroke": 2,
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "sys.uptime-value",
      "x": 548,
      "y": 360,
      "sensor": "sys.uptime",
      "format": "{value:duration}",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "hide_if_missing": true
    },
    {
      "type": "rect",
      "id": "card",
      "x": 760,
      "y": 40,
      "w": 380,
      "h": 400,
      "color": "@surf_1",
      "color2": "@base",
      "radius": 24,
      "outline": "@rule_soft"
    },
    {
      "type": "icon",
      "id": "weather-icon",
      "x": 786,
      "y": 80,
      "icon": "weather",
      "size": 112,
      "color": "@tx_1",
      "stroke": 2.4,
      "glow": 0.2,
      "hide_if_missing": true
    },
    {
      "type": "weather",
      "id": "weather-temp",
      "x": 1110,
      "y": 66,
      "field": "temperature",
      "format": "{value:.0f}°",
      "font_size": 120,
      "color": "@tx_1",
      "align": "right",
      "font": "builtin:Barlow-SemiBold",
      "hide_if_missing": true
    },
    {
      "type": "weather",
      "id": "weather-desc",
      "x": 792,
      "y": 232,
      "field": "description",
      "format": "{value}",
      "font_size": 30,
      "color": "@tx_2",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "rect",
      "id": "card-rule",
      "x": 792,
      "y": 302,
      "w": 316,
      "h": 1,
      "color": "@rule_soft",
      "needs": "weather.temperature"
    },
    {
      "type": "icon",
      "id": "weather-apparent_temperature-icon",
      "x": 792,
      "y": 340,
      "icon": "temperature",
      "size": 22,
      "color": "@tx_3",
      "stroke": 2,
      "needs": "weather.apparent_temperature"
    },
    {
      "type": "weather",
      "id": "weather-apparent_temperature",
      "x": 820,
      "y": 336,
      "field": "apparent_temperature",
      "format": "{value:.0f}°",
      "font_size": 23,
      "color": "@tx_2",
      "font": "builtin:Barlow-SemiBold",
      "hide_if_missing": true
    },
    {
      "type": "icon",
      "id": "weather-humidity-icon",
      "x": 892,
      "y": 340,
      "icon": "humidity",
      "size": 22,
      "color": "@tx_3",
      "stroke": 2,
      "needs": "weather.humidity"
    },
    {
      "type": "weather",
      "id": "weather-humidity",
      "x": 920,
      "y": 336,
      "field": "humidity",
      "format": "{value:.0f}%",
      "font_size": 23,
      "color": "@tx_2",
      "font": "builtin:Barlow-SemiBold",
      "hide_if_missing": true
    },
    {
      "type": "icon",
      "id": "weather-wind_speed-icon",
      "x": 988,
      "y": 340,
      "icon": "wind",
      "size": 22,
      "color": "@tx_3",
      "stroke": 2,
      "needs": "weather.wind_speed"
    },
    {
      "type": "weather",
      "id": "weather-wind_speed",
      "x": 1016,
      "y": 336,
      "field": "wind_speed",
      "format": "{value:.0f} {unit}",
      "font_size": 23,
      "color": "@tx_2",
      "font": "builtin:Barlow-SemiBold",
      "hide_if_missing": true
    },
    {
      "type": "clock",
      "id": "sheet-day",
      "x": 788,
      "y": 62,
      "format": "%d",
      "font_size": 170,
      "color": "@accent",
      "font": "builtin:Barlow-SemiBold",
      "glow": 0.35,
      "glow_radius": 12,
      "needs": "!weather.temperature"
    },
    {
      "type": "clock",
      "id": "sheet-weekday",
      "x": 792,
      "y": 268,
      "format": "%A",
      "font_size": 38,
      "color": "@tx_1",
      "tabular": false,
      "font": "builtin:Barlow-SemiBold",
      "needs": "!weather.temperature"
    },
    {
      "type": "clock",
      "id": "sheet-month",
      "x": 792,
      "y": 320,
      "format": "%B %Y",
      "font_size": 28,
      "color": "@tx_3",
      "tabular": false,
      "needs": "!weather.temperature"
    },
    {
      "type": "gauge",
      "id": "cpu-ring",
      "x": 1190,
      "y": 34,
      "w": 200,
      "h": 200,
      "sensor": "cpu.load",
      "thickness": 16,
      "color": "@cpu_deep",
      "color2": "@cpu",
      "background": "@track",
      "cap": "round",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "cpu.load"
    },
    {
      "type": "metric",
      "id": "cpu-load",
      "x": 1290,
      "y": 92,
      "sensor": "cpu.load",
      "format": "{value:.0f}%",
      "font_size": 54,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "cpu.load"
    },
    {
      "type": "text",
      "id": "cpu-label",
      "x": 1290,
      "y": 158,
      "text": "CPU",
      "font_size": 18,
      "color": "@cpu",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "cpu.load"
    },
    {
      "type": "metric",
      "id": "cpu-temp",
      "x": 1290,
      "y": 256,
      "sensor": "cpu.temp",
      "format": "{value:.0f}°C",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "color_rules": [
        {
          "above": 75,
          "color": "@warn"
        },
        {
          "above": 88,
          "color": "@krit"
        }
      ],
      "needs": "cpu.load"
    },
    {
      "type": "metric",
      "id": "cpu-power",
      "x": 1290,
      "y": 296,
      "sensor": "cpu.power",
      "format": "{value:.0f} W",
      "font_size": 22,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "cpu.load"
    },
    {
      "type": "gauge",
      "id": "mem-ring",
      "x": 1425,
      "y": 34,
      "w": 200,
      "h": 200,
      "sensor": "mem.load",
      "thickness": 16,
      "color": "@mem_deep",
      "color2": "@mem",
      "background": "@track",
      "cap": "round",
      "glow": 0.45,
      "glow_radius": 10,
      "smooth": true,
      "needs": "mem.load"
    },
    {
      "type": "metric",
      "id": "mem-load",
      "x": 1525,
      "y": 92,
      "sensor": "mem.load",
      "format": "{value:.0f}%",
      "font_size": 54,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "needs": "mem.load"
    },
    {
      "type": "text",
      "id": "mem-label",
      "x": 1525,
      "y": 158,
      "text": "RAM",
      "font_size": 18,
      "color": "@mem",
      "align": "center",
      "letter_spacing": 4,
      "font": "builtin:Barlow-SemiBold",
      "needs": "mem.load"
    },
    {
      "type": "metric",
      "id": "mem-used",
      "x": 1525,
      "y": 256,
      "sensor": "mem.used",
      "format": "{value:.1f} GB",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "color_rules": [],
