    },
    {
      "type": "metric",
      "id": "mem-total",
      "x": 1525,
      "y": 296,
      "sensor": "mem.total",
      "format": "/ {value:.0f} GB",
      "font_size": 22,
      "color": "@tx_3",
      "font": "builtin:Barlow-Medium",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "needs": "mem.load"
    },
    {
      "type": "gauge",
      "id": "gpu-ring",
      "x": 1660,
      "y": 34,
      "w": 200,
      "h": 200,
      "sensor": "gpu.load",
