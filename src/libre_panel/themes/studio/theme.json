      "id": "gpu-temp",
      "x": 1760,
      "y": 256,
      "sensor": "gpu.temp",
      "format": "{value:.0f}°C",
      "font_size": 30,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "align": "center",
      "tabular": true,
      "hide_if_missing": true,
      "color_rules": [
        {
          "above": 75,
