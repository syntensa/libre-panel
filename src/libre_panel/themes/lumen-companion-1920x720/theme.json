{
  "format": "libre-panel-theme/1",
  "name": "Lumen Companion",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Beside Lumen on a second panel: every core, the temperatures Lumen does not show with the fans turning, the drives and the processes.",
  "display": {
    "model": "turing-12.3-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "module",
      "id": "m-cores-0-0",
      "module": "cores",
      "col": 0,
      "row": 0,
      "cols": 3,
      "rows": 3,
      "total": false
    },
    {
      "type": "module",
      "id": "m-temps-3-0",
      "module": "temps",
      "col": 3,
      "row": 0,
      "cols": 3,
      "rows": 3,
      "items": "!cpu.temp\n!gpu.temp\ntemp.*"
    },
    {
      "type": "module",
      "id": "m-drives-6-0",
      "module": "drives",
      "col": 6,
      "row": 0,
      "cols": 2,
      "rows": 1
    },
    {
      "type": "module",
      "id": "m-processes-6-1",
      "module": "processes",
      "col": 6,
      "row": 1,
      "cols": 2,
      "rows": 2
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
