{
  "format": "libre-panel-theme/1",
  "name": "Encore Companion",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Beside Encore on a second panel while music plays: the cover large on its own colours, the weather and the sun and moon; what plays is on Encore.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 48,
    "gap": 1,
    "margin": 16
  },
  "toast": {
    "off": [
      "volume"
    ]
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "image",
      "id": "ambient",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 480,
      "src": "@media.cover",
      "fit": "cover",
      "blur": 56,
      "opacity": 0.9,
      "needs": "@media.cover"
    },
    {
      "type": "rect",
      "id": "veil",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 480,
      "color": "#0A0E1338",
      "color2": "#0A0E13F2",
      "gradient": "horizontal",
      "needs": "@media.cover"
    },
    {
      "type": "rect",
      "id": "cover-frame",
      "x": 24,
      "y": 24,
      "w": 432,
      "h": 432,
      "color": "#121A24",
      "radius": 18,
      "outline": "@line"
    },
    {
      "type": "icon",
      "id": "cover-icon",
      "x": 171,
      "y": 171,
      "icon": "music",
      "size": 138,
      "color": "@dim",
      "stroke": 1.6,
      "needs": "!@media.cover"
    },
    {
      "type": "image",
      "id": "cover",
      "x": 24,
      "y": 24,
      "w": 432,
      "h": 432,
      "src": "@media.cover",
      "fit": "cover",
      "radius": 18,
      "shadow": "#00000099",
      "shadow_offset": 6,
      "shadow_blur": 22
    },
    {
      "type": "module",
      "id": "m-weather-12-1",
      "module": "weather",
      "col": 12,
      "row": 1,
      "cols": 22,
      "rows": 46,
      "fallback": "none"
    },
    {
      "type": "module",
      "id": "m-sun-35-1",
      "module": "sun",
      "col": 35,
      "row": 1,
      "cols": 12,
      "rows": 46
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
