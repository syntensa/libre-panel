      "font": "builtin:Barlow-Medium",
      "font_size": 18,
      "color": "@accent",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "max_width": 220,
      "fit": "ellipsis"
    },
    {
      "type": "image",
      "id": "game-logo",
      "x": 292,
      "y": 62,
      "w": 150,
      "h": 42,
