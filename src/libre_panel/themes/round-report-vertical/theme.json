{
  "format": "libre-panel-theme/1",
  "name": "Round report Vertical",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "The round report for 8.8\" and 9.2\" bars on end: the round's frame rate against the average of your last rounds of the same game, its 1% low and frame time, who held the rate down, how much of the round ran at which frame rate (a tick on each bar marks the earlier rounds), and its highest temperatures, power and video memory against those rounds, in three cards one under the other.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "portrait",
    "width": 480,
    "height": 1920
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "round-card",
      "x": 30,
      "y": 40,
      "w": 438,
      "h": 560,
      "color": "#0D1219E6",
      "radius": 22,
      "outline": "@line",
      "outline_width": 2
    },
    {
      "type": "metric",
      "id": "round-title",
      "x": 56,
      "y": 67,
      "sensor": "report.title",
      "format": "{value:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 18,
      "color": "@accent",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "max_width": 220,
      "fit": "ellipsis"
    },
    {
      "type": "image",
      "id": "game-logo",
      "x": 292,
      "y": 62,
      "w": 150,
      "h": 42,
      "src": "@game.logo",
      "fit": "contain",
      "align": "right",
      "needs": "@game.logo"
    },
    {
      "type": "metric",
      "id": "game",
      "x": 56,
      "y": 105,
      "sensor": "report.game",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 38,
      "color": "@text",
      "tabular": false,
      "fallback": "",
      "max_width": 386,
      "fit": "ellipsis",
      "needs": "!@game.logo"
    },
    {
      "type": "metric",
      "id": "game-with-logo",
      "x": 56,
      "y": 105,
      "sensor": "report.game",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 38,
      "color": "@text",
      "tabular": false,
      "fallback": "",
      "max_width": 220,
      "fit": "ellipsis",
      "needs": "@game.logo"
    },
    {
      "type": "metric",
      "id": "when",
      "x": 56,
      "y": 162,
      "sensor": "report.when",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@text3",
      "fallback": "",
      "max_width": 124,
      "fit": "ellipsis"
    },
    {
      "type": "text",
      "id": "dot-1",
      "x": 184,
      "y": 162,
      "text": "·",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@dim",
      "tabular": false,
      "needs": "report.length"
    },
    {
      "type": "metric",
      "id": "length",
      "x": 200,
      "y": 162,
