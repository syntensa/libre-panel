{
  "format": "libre-panel-theme/1",
  "name": "Round report Vertical",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "The round report for 8.8\" and 9.2\" bars on end: the round's frame rate against the average of your last rounds of the same game, what all its frames came to (the 1% and 0.1% lows, the mean and the longest frame time), who held the rate down, how much of the round ran at which frame rate (a tick on each bar marks the earlier rounds), the CPU's and the GPU's temperature over the round, and its highest temperatures, power and video memory against those rounds, in four cards one under the other.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "portrait",
    "width": 480,
    "height": 1920
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "round-card",
      "x": 30,
      "y": 40,
      "w": 438,
      "h": 590,
      "color": "#0D1219E6",
      "radius": 17,
      "outline": "@line",
      "outline_width": 2
    },
    {
      "type": "metric",
      "id": "round-title",
      "x": 56,
      "y": 67,
