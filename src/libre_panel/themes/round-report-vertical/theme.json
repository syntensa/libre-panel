      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 124,
      "color": "@text",
      "fallback": "–",
      "finish": "acrylic"
    },
    {
      "type": "text",
      "id": "fps-label",
      "x": 285,
      "y": 226,
      "text": "Ø FPS",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 21,
      "color": "@accent",
      "tabular": false,
      "letter_spacing": 3
    },
    {
      "type": "metric",
      "id": "fps-delta",
      "x": 285,
      "y": 263,
      "sensor": "report.fps_delta",
      "format": "{value:+.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 30,
      "color": "@text3",
      "color_rules": [
        {
          "above": -0.5,
          "color": "@text3"
        },
        {
          "above": 0.5,
          "color": "@net"
        }
      ],
      "needs": "report.fps_delta"
    },
    {
