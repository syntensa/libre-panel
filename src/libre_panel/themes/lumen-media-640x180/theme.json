{
  "format": "libre-panel-theme/1",
  "name": "Lumen Media",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Lumen for one fan screen of the JONSBO ZC-360 (640x180): what plays (the weather when nothing does, the day while there is none).",
  "display": {
    "model": "jonsbo-zc360-screen",
    "orientation": "landscape",
    "width": 640,
    "height": 180
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 32,
    "rows": 12,
    "gap": 0,
    "margin": 0
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 2,
      "row": 1,
      "cols": 30,
      "rows": 10,
      "items": "",
      "change": 0.6,
      "hold": 2.0
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
