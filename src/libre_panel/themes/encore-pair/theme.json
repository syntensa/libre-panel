{
  "format": "libre-panel-theme/1",
  "name": "Encore",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Encore beside its companion on a second panel: what plays in large words, how far it is, the volume and the time; the cover is on the companion.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 48,
    "gap": 1,
    "margin": 16
  },
  "toast": {
    "off": [
      "volume"
    ]
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "image",
      "id": "ambient",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 480,
      "src": "@media.cover",
      "fit": "cover",
      "blur": 56,
      "opacity": 0.9,
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "veil",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 480,
      "color": "#0A0E1338",
      "color2": "#0A0E13F2",
      "gradient": "horizontal",
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "frame-text",
      "x": 24,
      "y": 24,
      "w": 1090,
      "h": 432,
      "color": null,
      "outline": "#6D7885",
      "outline_width": 3,
      "radius": 30,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-time",
      "x": 1134,
      "y": 24,
      "w": 762,
      "h": 432,
      "color": null,
      "outline": "#6D7885",
      "outline_width": 3,
      "radius": 30,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "icon",
      "id": "playing-sign",
      "x": 48,
      "y": 61,
      "icon": "play",
      "size": 22,
      "color": "@cover",
      "needs": "media.playing=1, media.title"
    },
    {
      "type": "icon",
      "id": "paused-sign",
      "x": 48,
      "y": 61,
      "icon": "pause",
      "size": 22,
      "color": "@cover",
      "needs": "media.playing=0, media.title"
    },
    {
      "type": "metric",
      "id": "state",
      "x": 82,
      "y": 57,
      "sensor": "media.state",
      "format": "{value:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@cover",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "max_width": 1008,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "title",
      "x": 48,
      "y": 97,
      "sensor": "media.title",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 62,
      "color": "@text",
      "tabular": false,
      "fallback": "",
      "max_width": 1042,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "artist",
      "x": 48,
      "y": 191,
      "sensor": "media.artist",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 36,
      "color": "@text2",
      "tabular": false,
      "fallback": "",
      "max_width": 1042,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "album",
      "x": 48,
      "y": 246,
      "sensor": "media.album",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 26,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 1042,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "image",
      "id": "app-icon",
      "x": 48,
      "y": 292,
      "w": 32,
      "h": 32,
      "src": "@media.app_icon",
      "fit": "contain",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "app",
      "x": 92,
      "y": 293,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 998,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "@media.app_icon, media.title"
    },
    {
      "type": "metric",
      "id": "app-bare",
      "x": 48,
      "y": 293,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 1042,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "!@media.app_icon, media.title"
    },
    {
      "type": "bar",
      "id": "progress",
      "x": 48,
      "y": 392,
      "w": 1042,
      "h": 8,
      "sensor": "media.progress",
      "min": 0,
      "max": 1,
      "color": "@cover",
      "background": "@track",
      "radius": 4,
      "smooth": true,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 10,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "position",
      "x": 48,
      "y": 415,
      "sensor": "media.position",
      "format": "{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text3",
      "max_width": 749,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "left",
      "x": 1090,
      "y": 415,
      "sensor": "media.remaining",
      "format": "-{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text3",
      "align": "right",
      "max_width": 749,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "text",
      "id": "idle",
      "x": 48,
      "y": 209,
      "text": "Nothing playing",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 44,
      "color": "@text2",
      "tabular": false,
      "translate": true,
      "needs": "!media.title"
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 1254,
      "y": 6,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 164,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 1701,
      "y": 41,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 48,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 10
    },
    {
      "type": "clock",
      "id": "date",
      "x": 1504,
      "y": 194,
      "format": "%A · %d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 21,
      "color": "@text3",
      "uppercase": true,
      "letter_spacing": 2.9,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "rect",
      "id": "seconds-groove",
      "x": 1254,
      "y": 241,
      "w": 501,
      "h": 2,
      "color": "@track"
    },
    {
      "type": "bar",
      "id": "seconds-run",
      "x": 1254,
      "y": 241,
      "w": 501,
      "h": 2,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "color": "@accent",
      "background": null,
      "radius": 0,
      "smooth": false,
      "end_dot": 4
    },
    {
      "type": "module",
      "id": "volume",
      "module": "volume",
      "col": 29,
      "row": 29,
      "cols": 18,
      "rows": 16,
      "card": "off"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
