{
  "format": "libre-panel-theme/1",
  "name": "Almanac Analog Vertical",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Almanac Analog for 8.8\" and 9.2\" bars on end: a face whose second hand glides to each second, the time and the day under it, and the month with today marked.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "portrait",
    "width": 480,
    "height": 1920
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 12,
    "rows": 48,
    "gap": 1,
    "margin": 16
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "frame-clock",
      "x": 30,
      "y": 24,
      "w": 438,
      "h": 886,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 17,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "analog",
      "id": "face",
      "x": 48,
      "y": 108,
      "w": 402,
      "h": 402,
      "color": "@text",
      "color2": "@accent",
      "face": "#111821",
      "marks": "@dim",
      "seconds": true,
      "hand": "glide",
      "glow": 0.15,
      "glow_radius": 12
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 67,
      "y": 543,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 117,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 387,
      "y": 566,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 39,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 10
    },
    {
      "type": "rect",
      "id": "seconds-groove",
      "x": 67,
      "y": 698,
      "w": 364,
      "h": 2,
      "color": "@track"
    },
    {
      "type": "bar",
      "id": "seconds-run",
      "x": 67,
      "y": 698,
      "w": 364,
      "h": 2,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "color": "@accent",
      "background": null,
      "radius": 0,
      "smooth": false,
      "end_dot": 4.5
    },
    {
      "type": "clock",
      "id": "weekday",
      "x": 249,
      "y": 700,
      "format": "%A",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 40,
      "color": "@text2",
      "tabular": false,
      "align": "center"
    },
    {
      "type": "clock",
      "id": "date",
      "x": 249,
      "y": 800,
      "format": "%d %B %Y",
      "font": "builtin:Barlow-Medium",
      "font_size": 23,
      "color": "@text3",
      "uppercase": true,
      "letter_spacing": 2.9,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "rect",
      "id": "month-card",
      "x": 30,
      "y": 930,
      "w": 438,
      "h": 966,
      "color": "#0D1219E6",
      "radius": 17,
      "outline": "@line",
      "outline_width": 2
    },
    {
      "type": "rect",
      "id": "frame-month",
      "x": 30,
      "y": 930,
      "w": 438,
      "h": 966,
      "color": "@surface",
      "outline": "@line",
      "outline_width": 2,
      "radius": 17,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "clock",
      "id": "month",
      "x": 60,
      "y": 957,
      "format": "%B %Y",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@accent",
      "uppercase": true,
      "letter_spacing": 4,
      "tabular": false
    },
    {
      "type": "clock",
      "id": "week",
      "x": 438,
      "y": 957,
      "format": "%V",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@text2",
      "letter_spacing": 2,
      "align": "right"
    },
    {
      "type": "text",
      "id": "week-label",
      "x": 399,
      "y": 957,
      "text": "Week",
      "font": "builtin:Barlow-Medium",
      "font_size": 22,
      "color": "@dim",
      "tabular": false,
      "translate": true,
      "uppercase": true,
      "letter_spacing": 4,
      "align": "right"
    },
    {
      "type": "calendar",
      "id": "days",
      "x": 52,
      "y": 1010,
      "w": 394,
      "h": 868,
      "font": "builtin:Barlow-Medium",
      "font_size": 34,
      "color": "@text2",
      "color2": "@accent",
      "muted": "@dim"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
