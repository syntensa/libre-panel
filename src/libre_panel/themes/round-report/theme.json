{
  "format": "libre-panel-theme/1",
  "name": "Round report",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "What the memory service shows after a game, in Libre Panel's look for 8.8\" and 9.2\" bars: the round's frame rate against the average of your last rounds of the same game, what all its frames came to (the 1% and 0.1% lows, the mean and the longest frame time), how much of the round ran at which frame rate (a tick on each bar marks the earlier rounds) and who held the rate down, the CPU's and the GPU's temperature over the round, and its highest temperatures, power and video memory against those rounds. Choose another theme for it with report_theme.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "round-card",
      "x": 16,
      "y": 16,
      "w": 500,
      "h": 448,
      "color": "#0D1219E6",
      "radius": 17,
      "outline": "@line",
      "outline_width": 2
    },
    {
      "type": "metric",
      "id": "round-title",
      "x": 44,
      "y": 42,
