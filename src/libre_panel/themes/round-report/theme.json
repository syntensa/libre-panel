      "format": "{value:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@accent",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "align": "left",
      "max_width": 244,
      "fit": "ellipsis"
    },
    {
      "type": "image",
      "id": "game-logo",
      "x": 298,
      "y": 38,
      "w": 190,
      "h": 52,
      "src": "@game.logo",
      "fit": "contain",
      "align": "right",
      "needs": "@game.logo"
