{
  "format": "libre-panel-theme/1",
  "name": "Round report",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "What the memory service shows after a game, in Libre Panel's look for 8.8\" and 9.2\" bars: the round's frame rate against the average of your last rounds of the same game, its 1% low and frame time, who held the rate down, how much of the round ran at which frame rate (a tick on each bar marks the earlier rounds), and its highest temperatures, power and video memory against those rounds. Choose another theme for it with report_theme.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "round-card",
      "x": 16,
      "y": 16,
      "w": 628,
      "h": 448,
      "color": "#0D1219E6",
      "radius": 17,
      "outline": "@line",
      "outline_width": 2
    },
    {
      "type": "metric",
      "id": "round-title",
      "x": 44,
      "y": 42,
      "sensor": "report.title",
      "format": "{value:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 19,
      "color": "@accent",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "align": "left",
      "max_width": 372,
      "fit": "ellipsis"
    },
    {
      "type": "image",
      "id": "game-logo",
      "x": 426,
      "y": 38,
      "w": 190,
      "h": 52,
      "src": "@game.logo",
      "fit": "contain",
      "align": "right",
      "needs": "@game.logo"
    },
    {
      "type": "metric",
      "id": "game",
      "x": 44,
      "y": 74,
      "sensor": "report.game",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 40,
      "color": "@text",
      "tabular": false,
      "fallback": "",
      "max_width": 572,
      "fit": "ellipsis",
      "needs": "!@game.logo"
    },
    {
      "type": "metric",
      "id": "game-with-logo",
      "x": 44,
      "y": 74,
