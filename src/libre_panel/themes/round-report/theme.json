{
  "format": "libre-panel-theme/1",
  "name": "Round report",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "For 8.8\" and 9.2\" bars (1920x480): the round report the memory service shows after a game, plainly: the frame rate against your last rounds of the same game, how much of the round ran at which frame rate, the highest temperatures and power, and the frame rate as it went. Choose another theme for it with report_theme.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "landscape",
    "width": 1920,
    "height": 480
  },
  "palette": {
    "base_low": "#060A0F",
    "base": "#0A1119",
    "track": "#162332",
    "rule_soft": "#1C2B3C",
    "tx_1": "#EEF6FF",
    "tx_2": "#B8CAE0",
    "tx_3": "#8CA0B8",
    "accent": "#13E5D7",
    "ok": "#6FE3B5",
    "warn": "#FFCB6B",
    "krit": "#FF7A85"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@base",
    "image": null
  },
  "refresh_ms": 500,
  "animation": {
    "smoothing_ms": 600
  },
  "widgets": [
    {
      "type": "rect",
      "id": "backdrop",
      "x": 0,
      "y": 0,
      "w": 1920,
      "h": 480,
      "color": "@base",
      "color2": "@base_low",
      "locked": true
    },
    {
      "type": "metric",
      "id": "title",
      "x": 48,
      "y": 26,
      "sensor": "report.title",
      "format": "{value}",
      "fallback": "Round report",
      "font_size": 24,
      "color": "@accent",
      "tabular": false,
      "font": "builtin:Barlow-SemiBold",
      "letter_spacing": 4
    },
    {
      "type": "rect",
      "id": "signature",
      "x": 50,
      "y": 60,
      "w": 96,
      "h": 4,
      "color": "@accent",
      "radius": 2,
      "glow": 0.6,
      "glow_radius": 8
    },
    {
      "type": "metric",
      "id": "game",
      "x": 46,
      "y": 72,
      "sensor": "report.game",
      "format": "{value}",
      "fallback": "Game",
      "font_size": 60,
      "color": "@tx_1",
      "tabular": false,
      "font": "builtin:Barlow-SemiBold",
      "max_width": 590
    },
    {
      "type": "metric",
      "id": "when",
      "x": 48,
      "y": 148,
      "sensor": "report.when",
      "format": "{value}",
      "fallback": "",
      "font_size": 26,
      "color": "@tx_2",
      "tabular": true
    },
    {
      "type": "metric",
      "id": "length",
      "x": 262,
      "y": 148,
      "sensor": "report.length",
      "format": "{value:duration}",
      "fallback": "",
      "font_size": 26,
      "color": "@tx_2",
      "tabular": false
    },
    {
      "type": "icon",
      "id": "outside-icon",
      "x": 350,
      "y": 150,
      "icon": "temperature",
      "size": 24,
      "color": "@tx_3",
      "stroke": 2,
      "needs": "report.outside"
    },
    {
      "type": "metric",
      "id": "outside",
      "x": 382,
      "y": 148,
      "sensor": "report.outside",
      "format": "{value:.0f}°C",
      "fallback": "--",
      "font_size": 26,
      "color": "@tx_2",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "needs": "report.outside"
    },
    {
      "type": "metric",
      "id": "versus",
      "x": 48,
      "y": 186,
      "sensor": "report.versus",
      "format": "{value}",
      "fallback": "",
      "font_size": 22,
      "color": "@tx_3",
      "tabular": false
    },
    {
      "type": "metric",
      "id": "fps",
      "x": 40,
      "y": 214,
      "sensor": "report.fps",
      "format": "{value:.0f}",
      "fallback": "--",
      "font_size": 150,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "glow": 0.18,
      "glow_radius": 14
    },
    {
      "type": "metric",
      "id": "fps-caption",
      "x": 48,
      "y": 368,
      "sensor": "report.fps",
      "format": "{label}",
      "fallback": "Average FPS",
      "font_size": 24,
      "color": "@accent",
      "tabular": false,
      "font": "builtin:Barlow-SemiBold",
      "letter_spacing": 3
    },
    {
      "type": "metric",
      "id": "fps-delta",
      "x": 330,
      "y": 262,
      "sensor": "report.fps_delta",
      "format": "{value:+.0f}",
      "fallback": "",
      "font_size": 44,
      "color": "@warn",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "color_rules": [
        {
          "above": -0.5,
          "color": "@tx_2"
        },
        {
          "above": 0.5,
          "color": "@ok"
        }
      ]
    },
    {
      "type": "metric",
      "id": "fps-delta-caption",
      "x": 332,
      "y": 318,
      "sensor": "report.fps_delta",
      "format": "{label}",
      "fallback": "",
      "font_size": 20,
      "color": "@tx_3",
      "tabular": false
    },
    {
      "type": "metric",
      "id": "low-caption",
      "x": 48,
      "y": 424,
      "sensor": "report.low",
      "format": "{label}",
      "fallback": "1% low",
      "font_size": 22,
      "color": "@tx_3",
      "tabular": false
    },
    {
      "type": "metric",
      "id": "low",
      "x": 150,
      "y": 410,
      "sensor": "report.low",
      "format": "{value:.0f}",
      "fallback": "--",
      "font_size": 40,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true
    },
    {
      "type": "metric",
      "id": "low-delta",
      "x": 232,
      "y": 420,
      "sensor": "report.low_delta",
      "format": "{value:+.0f}",
      "fallback": "",
      "font_size": 26,
      "color": "@warn",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true,
      "color_rules": [
        {
          "above": -0.5,
          "color": "@tx_2"
        },
        {
          "above": 0.5,
          "color": "@ok"
        }
      ]
    },
    {
      "type": "metric",
      "id": "frametime-caption",
      "x": 330,
      "y": 424,
      "sensor": "report.frametime",
      "format": "{label}",
      "fallback": "Frame time",
      "font_size": 22,
      "color": "@tx_3",
      "tabular": false
    },
    {
      "type": "metric",
      "id": "frametime",
      "x": 470,
      "y": 410,
      "sensor": "report.frametime",
      "format": "{value:.1f} ms",
      "fallback": "--",
      "font_size": 40,
      "color": "@tx_1",
      "font": "builtin:Barlow-SemiBold",
      "tabular": true
    },
    {
      "type": "rect",
      "id": "divider-1",
      "x": 650,
      "y": 32,
      "w": 2,
      "h": 420,
      "color": "@rule_soft"
    },
    {
      "type": "metric",
      "id": "levels-title",
      "x": 680,
      "y": 28,
      "sensor": "report.head.levels",
      "format": "{value}",
      "fallback": "",
      "font_size": 22,
      "color": "@tx_3",
      "tabular": false,
      "max_width": 540
    },
    {
      "type": "list",
      "id": "levels",
      "x": 680,
      "y": 64,
      "w": 560,
      "h": 300,
      "items": "report.level.5\nreport.level.4\nreport.level.3\nreport.level.2\nreport.level.1\nreport.level.0",
      "style": "bars",
      "max_items": 6,
      "font_size": 24,
      "color": "@tx_1",
      "muted": "@tx_3",
      "color2": "@accent",
      "background": "@track",
      "min": 0,
      "max": 100,
      "uppercase": false,
      "font": "builtin:Barlow-SemiBold",
      "label_font": "builtin:Barlow-Medium"
    },
    {
      "type": "metric",
      "id": "limit-caption",
      "x": 680,
      "y": 388,
      "sensor": "report.limit",
      "format": "{label}",
      "fallback": "",
      "font_size": 22,
      "color": "@tx_3",
      "tabular": false
    },
    {
      "type": "metric",
      "id": "limit",
      "x": 680,
      "y": 416,
      "sensor": "report.limit",
      "format": "{value}",
      "fallback": "",
      "font_size": 32,
      "color": "@tx_1",
      "tabular": false,
      "font": "builtin:Barlow-SemiBold"
    },
    {
      "type": "rect",
      "id": "divider-2",
      "x": 1260,
      "y": 32,
      "w": 2,
      "h": 420,
      "color": "@rule_soft"
    },
    {
      "type": "metric",
      "id": "peaks-title",
      "x": 1290,
      "y": 28,
      "sensor": "report.head.peaks",
      "format": "{value}",
      "fallback": "",
      "font_size": 22,
      "color": "@tx_3",
      "tabular": false,
      "max_width": 590
    },
    {
      "type": "list",
      "id": "peaks",
      "x": 1290,
      "y": 64,
      "w": 590,
      "h": 300,
      "items": "report.cpu_temp\nreport.gpu_temp\nreport.gpu_hotspot\nreport.cpu_power\nreport.gpu_power\nreport.vram_used",
      "style": "rows",
      "font_size": 24,
      "color": "@tx_1",
      "muted": "@tx_3",
      "uppercase": false,
      "font": "builtin:Barlow-SemiBold",
      "label_font": "builtin:Barlow-Medium"
    },
    {
      "type": "graph",
      "id": "fps-graph",
      "x": 1290,
      "y": 384,
      "w": 590,
      "h": 70,
      "sensor": "game.fps",
      "min": null,
      "max": null,
      "history": 300,
      "color": "@accent",
      "line_width": 2,
      "fill": true
    }
  ]
}
