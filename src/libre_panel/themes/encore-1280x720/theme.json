{
  "format": "libre-panel-theme/1",
  "name": "Encore 5.2″",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Encore laid out for the 5.2\" (1280x720): what plays with its cover, and under it the time and the volume.",
  "display": {
    "model": "turing-5.2-usb",
    "orientation": "landscape",
    "width": 1280,
    "height": 720
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 72,
    "gap": 1,
    "margin": 16
  },
  "toast": {
    "off": [
      "volume"
    ]
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "image",
      "id": "ambient",
      "x": 0,
      "y": 0,
      "w": 1280,
      "h": 720,
      "src": "@media.cover",
      "fit": "cover",
      "blur": 56,
      "opacity": 0.9,
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "veil",
      "x": 0,
      "y": 0,
      "w": 1280,
      "h": 720,
      "color": "#0A0E1338",
      "color2": "#0A0E13F2",
      "gradient": "horizontal",
      "needs": "media.title"
    },
    {
      "type": "rect",
      "id": "cover-frame",
      "x": 40,
      "y": 40,
      "w": 420,
      "h": 420,
      "color": "#121A24",
      "radius": 18,
      "outline": "@line",
      "needs": "!@media.cover"
    },
    {
      "type": "icon",
      "id": "cover-icon",
      "x": 181,
      "y": 181,
      "icon": "music",
      "size": 138,
      "color": "@dim",
      "stroke": 1.6,
      "needs": "!@media.cover"
    },
    {
      "type": "image",
      "id": "cover",
      "x": 40,
      "y": 40,
      "w": 420,
      "h": 420,
      "src": "@media.cover",
      "fit": "cover",
      "radius": 18,
      "shadow": "#00000099",
      "shadow_offset": 6,
      "shadow_blur": 22
    },
    {
      "type": "icon",
      "id": "playing-sign",
      "x": 500,
      "y": 68,
      "icon": "play",
      "size": 24,
      "color": "@cover",
      "needs": "media.playing=1, media.title"
    },
    {
      "type": "icon",
      "id": "paused-sign",
      "x": 500,
      "y": 68,
      "icon": "pause",
      "size": 24,
      "color": "@cover",
      "needs": "media.playing=0, media.title"
    },
    {
      "type": "metric",
      "id": "state",
      "x": 536,
      "y": 64,
      "sensor": "media.state",
      "format": "{value:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@cover",
      "letter_spacing": 3,
      "tabular": false,
      "fallback": "",
      "max_width": 552,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "title",
      "x": 500,
      "y": 104,
      "sensor": "media.title",
      "format": "{value}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 62,
      "color": "@text",
      "tabular": false,
      "fallback": "",
      "max_width": 740,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "artist",
      "x": 500,
      "y": 196,
      "sensor": "media.artist",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 38,
      "color": "@text2",
      "tabular": false,
      "fallback": "",
      "max_width": 740,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "metric",
      "id": "album",
      "x": 500,
      "y": 252,
      "sensor": "media.album",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 28,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 740,
      "fit": "ellipsis",
      "hide_if_missing": true
    },
    {
      "type": "image",
      "id": "app-icon",
      "x": 500,
      "y": 302,
      "w": 34,
      "h": 34,
      "src": "@media.app_icon",
      "fit": "contain",
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "app",
      "x": 546,
      "y": 304,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 694,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "@media.app_icon, media.title"
    },
    {
      "type": "metric",
      "id": "app-bare",
      "x": 500,
      "y": 304,
      "sensor": "media.source",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 24,
      "color": "@text3",
      "tabular": false,
      "fallback": "",
      "max_width": 740,
      "fit": "ellipsis",
      "hide_if_missing": true,
      "needs": "!@media.app_icon, media.title"
    },
    {
      "type": "bar",
      "id": "progress",
      "x": 500,
      "y": 404,
      "w": 740,
      "h": 8,
      "sensor": "media.progress",
      "min": 0,
      "max": 1,
      "color": "@cover",
      "background": "@track",
      "radius": 4,
      "smooth": true,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 10,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "position",
      "x": 500,
      "y": 424,
      "sensor": "media.position",
      "format": "{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 26,
      "color": "@text3",
      "max_width": 293,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "metric",
      "id": "left",
      "x": 1240,
      "y": 424,
      "sensor": "media.remaining",
      "format": "-{value:clock}",
      "font": "builtin:Barlow-Medium",
      "font_size": 26,
      "color": "@text3",
      "align": "right",
      "max_width": 293,
      "hide_if_missing": true,
      "needs": "media.title"
    },
    {
      "type": "text",
      "id": "idle",
      "x": 500,
      "y": 210,
      "text": "Nothing playing",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 46,
      "color": "@text2",
      "tabular": false,
      "translate": true,
      "needs": "!media.title"
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 40,
      "y": 488,
      "format": "%H:%M",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 128,
      "color": "@text",
      "digits": "roll",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 390,
      "y": 516,
      "format": "%S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 40,
      "color": "@accent",
      "digits": "roll",
      "glow": 0.6,
      "glow_radius": 10
    },
    {
      "type": "clock",
      "id": "date",
      "x": 239,
      "y": 635,
      "format": "%A · %d %B",
      "font": "builtin:Barlow-Medium",
      "font_size": 21,
      "color": "@text3",
      "uppercase": true,
      "letter_spacing": 3,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "rect",
      "id": "seconds-groove",
      "x": 40,
      "y": 662,
      "w": 398,
      "h": 2,
      "color": "@track"
    },
    {
      "type": "bar",
      "id": "seconds-run",
      "x": 40,
      "y": 662,
      "w": 398,
      "h": 2,
      "sensor": "time.second",
      "min": 0,
      "max": 60,
      "color": "@accent",
      "background": null,
      "radius": 0,
      "smooth": false,
      "end_dot": 4
    },
    {
      "type": "module",
      "id": "volume",
      "module": "volume",
      "col": 24,
      "row": 50,
      "cols": 24,
      "rows": 21,
      "card": "off"
    }
  ]
}
