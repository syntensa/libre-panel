{
  "format": "libre-panel-theme/1",
  "name": "Lumen Vertical",
  "author": "Libre Panel contributors",
  "license": "CC0-1.0",
  "description": "Lumen for 8.8\" and 9.2\" bars on end: what plays (the weather when nothing does, the day while there is none), the time, the load of the last minute and the fans, lit rings for CPU, GPU and RAM named after your hardware, and the network.",
  "display": {
    "model": "turing-9.2-usb",
    "orientation": "portrait",
    "width": 480,
    "height": 1920
  },
  "palette": {
    "bg": "#0A0E13",
    "bg2": "#06090D",
    "surface": "#0D1219",
    "line": "#1F2A36",
    "track": "#18212C",
    "text": "#E8EEF4",
    "text2": "#C9D3DE",
    "text3": "#93A1B2",
    "dim": "#5F6E80",
    "accent": "#2EE6D6",
    "cpu": "#2EE6D6",
    "gpu": "#7F9CFF",
    "mem": "#C792FF",
    "disk": "#5FB6FF",
    "net": "#34D399",
    "warn": "#F5C46B",
    "crit": "#F87171"
  },
  "font": "builtin:Barlow-Medium",
  "background": {
    "color": "@bg",
    "image": "assets/backdrop.png"
  },
  "refresh_ms": 1000,
  "animation": {
    "smoothing_ms": 600
  },
  "grid": {
    "columns": 48,
    "rows": 96,
    "gap": 1,
    "margin": 16
  },
  "style": {
    "card": "glass",
    "radius": 14,
    "glow": 0.6,
    "backdrop": "flat",
    "display_font": "builtin:Barlow-SemiBold",
    "text_font": "builtin:Barlow-Medium"
  },
  "widgets": [
    {
      "type": "rect",
      "id": "frame-mid",
      "x": 34,
      "y": 507,
      "w": 430,
      "h": 494,
      "color": "@surface",
      "outline": "#6D7885",
      "outline_width": 3,
      "radius": 30,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-rings",
      "x": 34,
      "y": 1021,
      "w": 430,
      "h": 687,
      "color": "@surface",
      "outline": "#6D7885",
      "outline_width": 3,
      "radius": 30,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "rect",
      "id": "frame-net",
      "x": 34,
      "y": 1728,
      "w": 430,
      "h": 156,
      "color": "@surface",
      "outline": "#6D7885",
      "outline_width": 3,
      "radius": 11,
      "locked": true,
      "needs": "switch.frames"
    },
    {
      "type": "module",
      "id": "card",
      "module": "cards",
      "col": 0,
      "row": 1,
      "cols": 48,
      "rows": 23,
      "items": "playback\nforecast\ndate",
      "change": 0.6,
      "hold": 2.0
    },
    {
      "type": "clock",
      "id": "clock",
      "x": 66,
      "y": 503,
      "format": "%H:%M",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 118,
      "color": "@text",
      "align": "left",
      "finish": "acrylic"
    },
    {
      "type": "clock",
      "id": "seconds",
      "x": 388,
      "y": 527,
      "format": "%S",
      "digits": "roll",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 38,
      "color": "@accent",
      "glow": 0.6,
      "glow_radius": 10
    },
    {
      "type": "clock",
      "id": "date",
      "x": 249,
      "y": 643,
      "format": "%A · %d %B",
      "uppercase": true,
      "font": "builtin:Barlow-Medium",
      "font_size": 21,
      "color": "@text3",
      "letter_spacing": 2.9,
      "tabular": false,
      "align": "center"
    },
    {
      "type": "text",
      "id": "legend-cpu",
      "x": 52,
      "y": 701,
      "text": "CPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@cpu",
      "letter_spacing": 1.9,
      "tabular": false
    },
    {
      "type": "text",
      "id": "legend-gpu",
      "x": 111,
      "y": 701,
      "text": "GPU",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@gpu",
      "letter_spacing": 1.9,
      "tabular": false,
      "needs": "gpu.load"
    },
    {
      "type": "text",
      "id": "legend-span",
      "x": 446,
      "y": 701,
      "text": "60 S",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 13,
      "color": "@dim",
      "letter_spacing": 1.9,
      "tabular": false,
      "align": "right"
    },
    {
      "type": "graph",
      "id": "gpu-graph",
      "x": 52,
      "y": 725,
      "w": 394,
      "h": 133,
      "sensor": "gpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@gpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.4,
      "glow_radius": 6,
      "needs": "gpu.load"
    },
    {
      "type": "graph",
      "id": "cpu-graph",
      "x": 52,
      "y": 725,
      "w": 394,
      "h": 133,
      "sensor": "cpu.load",
      "min": 0,
      "max": 100,
      "history": 120,
      "color": "@cpu",
      "fill": true,
      "fill_fade": true,
      "smooth": true,
      "line_width": 2,
      "finish": "lit",
      "glow": 0.5,
      "glow_radius": 6
    },
    {
      "type": "rect",
      "id": "graph-base",
      "x": 52,
      "y": 859,
      "w": 394,
      "h": 1,
      "color": "@line"
    },
    {
      "type": "fan",
      "id": "fan-1",
      "x": 52,
      "y": 887,
      "w": 40,
      "h": 40,
      "sensor": "gpu.fan",
      "color": "@gpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-name",
      "x": 100,
      "y": 886,
      "sensor": "gpu.fan",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 13,
      "color": "@text3",
      "letter_spacing": 1.0,
      "tabular": false,
      "max_width": 140,
      "fit": "ellipsis",
      "needs": "gpu.fan"
    },
    {
      "type": "metric",
      "id": "fan-1-rpm",
      "x": 100,
      "y": 902,
      "sensor": "gpu.fan",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 19,
      "max_width": 140,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "gpu.fan"
    },
    {
      "type": "fan",
      "id": "fan-2",
      "x": 249,
      "y": 887,
      "w": 40,
      "h": 40,
      "sensor": "fan.lpc.fan_1",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-name",
      "x": 297,
      "y": 886,
      "sensor": "fan.lpc.fan_1",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 13,
      "color": "@text3",
      "letter_spacing": 1.0,
      "tabular": false,
      "max_width": 140,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "metric",
      "id": "fan-2-rpm",
      "x": 297,
      "y": 902,
      "sensor": "fan.lpc.fan_1",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 19,
      "max_width": 140,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_1"
    },
    {
      "type": "fan",
      "id": "fan-3",
      "x": 52,
      "y": 939,
      "w": 40,
      "h": 40,
      "sensor": "fan.lpc.fan_2",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-name",
      "x": 100,
      "y": 938,
      "sensor": "fan.lpc.fan_2",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 13,
      "color": "@text3",
      "letter_spacing": 1.0,
      "tabular": false,
      "max_width": 140,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "metric",
      "id": "fan-3-rpm",
      "x": 100,
      "y": 954,
      "sensor": "fan.lpc.fan_2",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 19,
      "max_width": 140,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_2"
    },
    {
      "type": "fan",
      "id": "fan-4",
      "x": 249,
      "y": 939,
      "w": 40,
      "h": 40,
      "sensor": "fan.lpc.fan_3",
      "color": "@cpu",
      "max_rpm": 3000,
      "frame": "ring",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-name",
      "x": 297,
      "y": 938,
      "sensor": "fan.lpc.fan_3",
      "format": "{label:upper}",
      "font": "builtin:Barlow-Medium",
      "font_size": 13,
      "color": "@text3",
      "letter_spacing": 1.0,
      "tabular": false,
      "max_width": 140,
      "fit": "ellipsis",
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "metric",
      "id": "fan-4-rpm",
      "x": 297,
      "y": 954,
      "sensor": "fan.lpc.fan_3",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "font_size": 19,
      "max_width": 140,
      "fit": "ellipsis",
      "color": "@text",
      "smooth": true,
      "needs": "fan.lpc.fan_3"
    },
    {
      "type": "list",
      "id": "fans",
      "x": 52,
      "y": 887,
      "w": 394,
      "h": 91,
      "items": "fan.*",
      "style": "rows",
      "columns": 2,
      "max_items": 4,
      "sort": "none",
      "format": "{value:.0f}",
      "font": "builtin:Barlow-SemiBold",
      "label_font": "builtin:Barlow-Medium",
      "font_size": 19,
      "uppercase": true,
      "color": "@text",
      "muted": "@text3",
      "color2": "@cpu",
      "levels": false,
      "empty": "",
      "needs": "!gpu.fan, !fan.lpc.fan_1"
    },
    {
      "type": "module",
      "id": "cpu-ring",
      "module": "instrument",
      "col": 3,
      "row": 52,
      "cols": 42,
      "rows": 11,
      "source": "cpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "cpu-name",
      "x": 148,
      "y": 1242,
      "sensor": "cpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "align": "center",
      "max_width": 210,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "gpu-ring",
      "module": "instrument",
      "col": 3,
      "row": 63,
      "cols": 42,
      "rows": 11,
      "source": "gpu",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "gpu-name",
      "x": 148,
      "y": 1458,
      "sensor": "gpu.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "align": "center",
      "max_width": 210,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "mem-ring",
      "module": "instrument",
      "col": 3,
      "row": 74,
      "cols": 42,
      "rows": 11,
      "source": "mem",
      "card": "off"
    },
    {
      "type": "metric",
      "id": "mem-name",
      "x": 148,
      "y": 1675,
      "sensor": "mem.name",
      "format": "{value}",
      "font": "builtin:Barlow-Medium",
      "font_size": 14,
      "color": "@text3",
      "align": "center",
      "max_width": 210,
      "fit": "ellipsis",
      "tabular": false,
      "hide_if_missing": true
    },
    {
      "type": "module",
      "id": "net",
      "module": "netcard",
      "col": 3,
      "row": 88,
      "cols": 42,
      "rows": 6,
      "card": "off"
    }
  ],
  "switches": {
    "frames": {
      "label": "Frames around every part",
      "on": true
    }
  }
}
