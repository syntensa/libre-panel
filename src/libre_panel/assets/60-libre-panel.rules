# Libre Panel: let logged-in users access USB system-monitor panels.
# Install:
#   libre-panel udev-rules | sudo tee /etc/udev/rules.d/60-libre-panel.rules
#   sudo udevadm control --reload-rules
# then unplug and replug the panel.

# Turing / TURZX V1.x USB panels (1.6" to 12.3", the pump of JONSBO's TF3-360SC), and Lian Li's
# Universal Screen and HydroShift II, which speak a protocol close to theirs
SUBSYSTEM=="usb", ATTRS{idVendor}=="1cbe", MODE="0660", TAG+="uaccess"

# JONSBO ZC-360: the three screens under its fans (3.38", "TURZX-338inch-r")
SUBSYSTEM=="usb", ATTRS{idVendor}=="43a8", ATTRS{idProduct}=="0e61", MODE="0660", TAG+="uaccess"

# JONSBO DS339: its USB display chip (MacroSilicon MS9132)
SUBSYSTEM=="usb", ATTRS{idVendor}=="345f", ATTRS{idProduct}=="9132", MODE="0660", TAG+="uaccess"

# Thermalright's Trofeo Vision: the 6.86" (a HID device) and the 9.16" and 11.3" bars
SUBSYSTEM=="usb", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5302", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5408", MODE="0660", TAG+="uaccess"
