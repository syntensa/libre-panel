<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- the libraries load also where Windows marked them as downloaded and the mark could not
         be taken off (libre_panel.unblock) -->
    <loadFromRemoteSources enabled="true" />
    <!-- one collector without a thread of its own beside it: what the service holds is small -->
    <gcConcurrent enabled="false" />
  </runtime>
</configuration>
