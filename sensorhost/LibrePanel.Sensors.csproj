<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Libre Panel's sensor service as a .NET program of its own (Windows): libre-panel-sensors.exe
    hosts LibreHardwareMonitor and answers on the pipe as the Python service does
    (src/libre_panel/sensorservice), with neither Python nor pythonnet in the process.

      python packaging/windows/fetch_lhm.py
      dotnet build sensorhost -c Release

    It is built against the libraries fetch_lhm.py checks and puts into packaging/windows/lhm-libs,
    and they go beside it into "lhm" (bin/Release: the folder "sensors" of the downloads).
    The .NET Framework's reference assemblies come from NuGet, pinned in packages.lock.json.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- LibreHardwareMonitor's .NET Framework build, which the Python service runs too -->
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>libre-panel-sensors</AssemblyName>
    <RootNamespace>LibrePanel.Sensors</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <!-- the libraries are loaded by name from "lhm" (Libraries.cs), as pythonnet does -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationIcon>..\packaging\icons\libre-panel.ico</ApplicationIcon>
    <!-- what it says of itself, as the Python programs do (the spec's version_resource) -->
    <Company>Libre Panel contributors</Company>
    <Product>Libre Panel</Product>
    <AssemblyTitle>Libre Panel sensor service</AssemblyTitle>
    <Copyright>Libre Panel contributors, GPL-3.0-or-later</Copyright>
    <Version>0.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LhmLibs Condition="'$(LhmLibs)' == ''">$(MSBuildThisFileDirectory)..\packaging\windows\lhm-libs</LhmLibs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>$(LhmLibs)\LibreHardwareMonitorLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- the libraries, their licences and SOURCES.txt, as fetch_lhm.py left them -->
    <None Include="$(LhmLibs)\**\*" Link="lhm\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
